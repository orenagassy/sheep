  function setSyncStatus(text, kind) {
    syncIndicator.textContent = text || '';
    syncIndicator.className = 'sync-indicator' + (kind ? ' ' + kind : '');
  }
  function sanitizeLeaderboard(data) {
    if (!Array.isArray(data)) return [];
    return data.filter(entry =>
      entry &&
      typeof entry.name === 'string' &&
      /^[A-Z0-9 ]{1,10}$/.test(entry.name) &&
      Number.isFinite(entry.score) &&
      entry.score >= 0
    ).slice(0, MAX_LEADERBOARD);
  }
  function loadLocalLeaderboard() {
    try { leaderboard = sanitizeLeaderboard(JSON.parse(localStorage.getItem(LB_LOCAL_KEY))); }
    catch (_) { leaderboard = []; }
  }
  function saveLocalLeaderboard() {
    try { localStorage.setItem(LB_LOCAL_KEY, JSON.stringify(leaderboard)); } catch (_) {}
  }
  function extractScores(data) {
    if (!data) return [];
    const arr = data.scores ?? (Array.isArray(data) ? data : []);
    return sanitizeLeaderboard(arr);
  }
  async function loadLeaderboard() {
    if (GROUP_MODE) { await loadGroupLeaderboard(); return; }
    if (SPORT_MODE) { loadLocalLeaderboard(); renderLeaderboard(); return; }
    setSyncStatus('Syncing...', 'syncing');
    try {
      const res = await fetch(`${FIREBASE_DB_URL}/leaderboard.json`);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      leaderboard = extractScores(await res.json());
      setSyncStatus('Synced', '');
    } catch (e) {
      console.error('Failed to load leaderboard', e);
      setSyncStatus('Offline', 'error');
    }
    if (leaderboard.length === 0) loadLocalLeaderboard();
    renderLeaderboard();
  }
  async function saveLeaderboard() {
    if (GROUP_MODE) { return await saveGroupLeaderboard(); }
    if (SPORT_MODE) {
      leaderboard.sort((a, b) => b.score - a.score);
      leaderboard = leaderboard.slice(0, MAX_LEADERBOARD);
      saveLocalLeaderboard(); renderLeaderboard(); return true;
    }
    setSyncStatus('Saving...', 'syncing');
    try {
      const latestRes = await fetch(`${FIREBASE_DB_URL}/leaderboard.json`);
      let serverScores = [];
      if (latestRes.ok) serverScores = extractScores(await latestRes.json());
      const combined = [...serverScores, ...leaderboard];
      const seen = new Set();
      const merged = [];
      for (const entry of combined) {
        const key = entry.name + '|' + entry.score + '|' + (entry.date || '');
        if (!seen.has(key)) { seen.add(key); merged.push(entry); }
      }
      merged.sort((a, b) => b.score - a.score);
      const trimmed = merged.slice(0, MAX_LEADERBOARD);
      const putRes = await fetch(authUrl(`${FIREBASE_DB_URL}/leaderboard.json`), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scores: trimmed })
      });
      if (!putRes.ok) throw new Error('HTTP ' + putRes.status);
      leaderboard = trimmed;
      try { localStorage.setItem(LOCAL_FALLBACK_KEY, JSON.stringify(leaderboard)); } catch (_) {}
      setSyncStatus('Synced', '');
      return true;
    } catch (e) {
      console.error('Failed to save leaderboard', e);
      setSyncStatus('Save failed', 'error');
      try { localStorage.setItem(LOCAL_FALLBACK_KEY, JSON.stringify(leaderboard)); } catch (_) {}
      return false;
    }
  }
