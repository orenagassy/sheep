  function newRound() {
    state.isRainbowRound = false;
    const rainbowChance = TEST_MODE ? 0.25 : (_cfg._k ?? 0.05);
    if (Math.random() < rainbowChance) {
      state.isRainbowRound = true;
      state.rainbowRoundUsed = true;
    }

    if (state.isRainbowRound) {
      state.blockedGates = [];
      state.hintGateIdx = -1; state.hintCloverIdx = -1; state.hintDoubleScoreIdx = -1;
      state.rainbowGateBonuses = Array.from({length: GATES_PER_ROUND},
        () => RAINBOW_BONUS_TYPES[Math.floor(Math.random() * RAINBOW_BONUS_TYPES.length)]);
      rainbowSkyEl.style.opacity = '1';
    } else {
      state.blockedGates = pickBlockedIndices(getBlockedCount());
      rainbowSkyEl.style.opacity = '0';
      const openGates = Array.from({length: GATES_PER_ROUND}, (_, i) => i)
        .filter(i => !state.blockedGates.includes(i));
      const legChance = TEST_MODE ? 1 : (_cfg._h ?? 1/10);
      const clovChance = TEST_MODE ? 1 : (_cfg._i ?? 1/10);
      const dblChance  = TEST_MODE ? 1 : (_cfg._j ?? 1/10);
      state.hintGateIdx = (Math.random() < legChance)
        ? openGates[Math.floor(Math.random() * openGates.length)] : -1;
      const openForClover = state.hintGateIdx >= 0 ? openGates.filter(i => i !== state.hintGateIdx) : openGates;
      state.hintCloverIdx = (Math.random() < clovChance)
        ? (openForClover.length > 0 ? openForClover[Math.floor(Math.random() * openForClover.length)] : -1) : -1;
      const openForDouble = state.hintCloverIdx >= 0 ? openForClover.filter(i => i !== state.hintCloverIdx) : openForClover;
      state.hintDoubleScoreIdx = (Math.random() < dblChance)
        ? (openForDouble.length > 0 ? openForDouble[Math.floor(Math.random() * openForDouble.length)] : -1) : -1;
    }
    state.animating = false;
    messageEl.textContent = ''; messageEl.style.color = 'var(--text-primary)';
    restartBtn.style.display = 'none';
    statusLabel.textContent = state.isRainbowRound ? '🌈 Rainbow Round — every gate hides a bonus!' : 'Pick the open gate';
