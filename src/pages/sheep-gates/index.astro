---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/sheep-gates.css';
---
<BaseLayout title="Sheep Gates">
<div class="app">
  <h1><span id="title-sheep">🐑</span> Sheep Gates</h1>
  <p class="tagline">Bet on the open gate. Survive as long as you can.</p>


  <div class="ad-wrap ad-wrap--top">
    <!-- Ad unit loads here after AdSense approval -->
  </div>

  <div id="game-container">

    <div class="topbar">
      <div class="topbar-left">
        <span id="test-badge">👁 GOD</span>
        <span id="mute-badge">🔇 MUTE</span>
        <span id="sport-badge">⚡ SPORT</span>
        <div>
          <div class="hud-title" id="round-label">Gate 1 · Level 1</div>
          <div class="hud-subtitle" id="status-label">Pick the open gate</div>
        </div>
      </div>
      <div class="stat-group">
        <div class="stat">
          <div class="stat-label">Score</div>
          <div class="stat-value" id="score">0</div>
        </div>
        <div class="stat">
          <div class="stat-label">Your best</div>
          <div class="stat-value" id="personal-best-display">—</div>
        </div>
      </div>
    </div>

    <div class="level-bar-wrap">
      <div class="level-bar-text">
        <span id="level-label">Level 1 · 6 of 7 open</span>
        <span id="level-progress-text">0 / 7</span>
      </div>
      <div class="level-bar-track">
        <div class="level-bar-fill" id="level-progress-bar"></div>
      </div>
      <div id="streak-row"></div>
    </div>

    <div id="field">
      <div id="chicken-leg-hud" title="You have a chicken leg! The wolf will eat it instead of you.">🍗</div>
      <div id="lucky-clover-hud" title="Lucky Clover! Click to scare away one wolf.">🍀</div>
      <div id="double-score-hud" title="2X Score! Your next rounds count double.">2X</div>
      <div id="sport-timer"><div id="sport-timer-bar"></div></div>
      <div id="field-overlay"></div>
      <div id="stars"></div>
      <div id="rainbow-sky"><div class="rainbow-arc"></div></div>
      <div id="clouds">
        <div class="cloud c1"></div>
        <div class="cloud c2"></div>
        <div class="cloud c3"></div>
      </div>
      <div id="world"></div>
      <div id="grass-blades"></div>
      <div id="sheep" aria-hidden="true">
        <span id="sheep-dead"></span>
        <svg id="sheep-svg" viewBox="0 0 70 58" width="70" height="58"
             xmlns="http://www.w3.org/2000/svg" style="overflow:visible;display:block;">
          <circle cx="38" cy="26" r="17" fill="#eeeae0"/>
          <circle cx="27" cy="21" r="12" fill="#f3f1e8"/>
          <circle cx="44" cy="19" r="12" fill="#edeae2"/>
          <circle cx="51" cy="27" r="10" fill="#e9e6dc"/>
          <circle cx="28" cy="33" r="10" fill="#e9e6dc"/>
          <circle cx="41" cy="34" r="8"  fill="#e6e3d9"/>
          <ellipse cx="13" cy="33" rx="10" ry="9" fill="#d5caaf"/>
          <ellipse cx="6" cy="37" rx="5" ry="4" fill="#c9bda0"/>
          <circle cx="4.5" cy="38.5" r="1.1" fill="#9c8c74"/>
          <circle cx="7.5" cy="38.5" r="1.1" fill="#9c8c74"/>
          <circle cx="11" cy="30" r="2.2" fill="#1e1810"/>
          <circle cx="10.2" cy="29.2" r="0.6" fill="white"/>
          <ellipse cx="18" cy="25" rx="3.5" ry="5.5" fill="#d5caaf" transform="rotate(15,18,25)"/>
          <ellipse cx="18" cy="25" rx="2"   ry="3.5" fill="#edc0b8" transform="rotate(15,18,25)"/>
          <g class="leg leg-bl">
            <rect x="49" y="42" width="6" height="13" rx="3"   fill="#c2b89a"/>
            <rect x="49" y="51" width="6" height="5"  rx="2"   fill="#3a2e1e"/>
          </g>
          <g class="leg leg-br">
            <rect x="55" y="42" width="5" height="13" rx="2.5" fill="#b4aa8c"/>
            <rect x="55" y="51" width="5" height="5"  rx="2"   fill="#2e2418"/>
          </g>
          <g class="leg leg-fl">
            <rect x="26" y="42" width="6" height="13" rx="3"   fill="#cac0a0"/>
            <rect x="26" y="51" width="6" height="5"  rx="2"   fill="#3a2e1e"/>
          </g>
          <g class="leg leg-fr">
            <rect x="33" y="42" width="5" height="13" rx="2.5" fill="#bcb294"/>
            <rect x="33" y="51" width="5" height="5"  rx="2"   fill="#2e2418"/>
          </g>
          <!-- sport bolt badge on wool (shown only in sport mode) -->
          <g id="sheep-sport-bolt" display="none">
            <circle cx="45" cy="23" r="7" fill="#ffb300" opacity="0.92"/>
            <text x="45" y="23" font-size="11" text-anchor="middle" dominant-baseline="middle" fill="#3d1a00">⚡</text>
          </g>
          <!-- devious face (shown only when feeding the wolf) -->
          <g id="sheep-devious-face" display="none">
            <path d="M7.5 27.5 Q10.5 24 14 27" fill="none" stroke="#1e1810" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="12" cy="30.8" r="0.65" fill="#e53935"/>
            <path d="M3.5 39 Q6 41.8 10.5 38.5" fill="none" stroke="#6d4c41" stroke-width="1.4" stroke-linecap="round"/>
            <polygon points="6,39.5 8,39.5 7,42" fill="white"/>
          </g>
        </svg>
      </div>
      <div id="grass-front"></div>
      <div id="message"></div>
      <div id="level-up-banner">Level up!</div>
    </div>

    <div id="hiscore-entry" style="display: none;">
      <div class="entry-title">🏅 New world best!</div>
      <div class="entry-subtitle">Enter your name (up to 10 characters)</div>
      <div class="entry-row">
        <input id="hiscore-name" type="text" maxlength="10" autocomplete="off"
               style="width: 160px; text-align: center; text-transform: uppercase; font-size: 16px; letter-spacing: 2px; font-weight: 500;" />
        <button id="hiscore-save" style="font-weight: 500;">Save</button>
      </div>
    </div>

    <div class="action-bar">
      <button id="restart-btn" style="display: none;">Try again</button>
    </div>

    <details>
      <summary>How to play</summary>
      <p>7 gates per row — pick an open one to keep walking. Every 7 gates, one more gate locks: Level 1 is 6 of 7 open, all the way down to 1 of 7.<br/><br/>
      Some gates hide surprises — discover them as you play!</p>
    </details>
  </div>

</div>

<div id="info-overlay"></div>
<div id="info-drawer">
  <div id="info-drawer-header">
    <span>Leaderboard &amp; Stats</span>
    <button id="info-close">✕</button>
  </div>

  <div style="display:flex;gap:8px;margin-bottom:16px">
    <div style="flex:1;display:flex;justify-content:space-between;align-items:center;background:var(--bg-soft);border-radius:8px;padding:8px 12px">
      <span style="font-size:13px;font-weight:500">👁 God Mode</span>
      <button id="god-mode-toggle" style="font-size:12px;font-weight:600;min-width:44px"></button>
    </div>
    <div style="flex:1;display:flex;justify-content:space-between;align-items:center;background:var(--bg-soft);border-radius:8px;padding:8px 12px">
      <span style="font-size:13px;font-weight:500">🔇 Mute</span>
      <button id="mute-toggle" style="font-size:12px;font-weight:600;min-width:44px"></button>
    </div>
  </div>

  <div id="leaderboard">
    <div class="leaderboard-title">
      <span id="leaderboard-title">Top 5 of all time</span>
      <span class="sync-indicator" id="sync-indicator"></span>
    </div>
    <div id="leaderboard-list"></div>
  </div>
  <div id="stats-panel">
    <div class="stats-title">Your all-time stats</div>
    <div class="stats-grid">
      <div>
        <div class="stat-item-label">Gates cleared</div>
        <div class="stat-item-value" id="stat-gates">0</div>
      </div>
      <div>
        <div class="stat-item-label">Games played</div>
        <div class="stat-item-value" id="stat-games">0</div>
      </div>
      <div>
        <div class="stat-item-label">Average score</div>
        <div class="stat-item-value" id="stat-avg">—</div>
      </div>
      <div>
        <div class="stat-item-label">Best level</div>
        <div class="stat-item-value" id="stat-level">1</div>
      </div>
      <div>
        <div class="stat-item-label">Lives saved 🍗</div>
        <div class="stat-item-value" id="stat-hints-used">0</div>
      </div>
      <div>
        <div class="stat-item-label">Drumsticks found</div>
        <div class="stat-item-value" id="stat-hints-found">0</div>
      </div>
      <div>
        <div class="stat-item-label">Best streak</div>
        <div class="stat-item-value" id="stat-streak">0</div>
      </div>
      <div>
        <div class="stat-item-label">Personal best</div>
        <div class="stat-item-value" id="stat-personal-best">—</div>
      </div>
    </div>
  </div>

  <div class="ad-wrap ad-wrap--drawer">
    <!-- Ad unit loads here after AdSense approval -->
  </div>
  <div id="drawer-credits">⚡🧠🐢</div>
</div>

<div id="mode-overlay">
  <div id="mode-popup">
    <div id="mode-popup-result" style="display:none">
      <div id="mode-popup-score-val"></div>
      <div id="mode-popup-score-sub"></div>
    </div>
    <div id="mode-popup-topbar">
      <div id="mode-popup-title">🐑 Sheep Gates</div>
      <button id="popup-stats-btn" title="Leaderboard &amp; stats">☰</button>
    </div>
    <div id="mode-popup-sub">Choose your mode</div>
    <div id="mode-btn-wrap">
      <button id="mpc-normal" class="mode-btn">
        <span class="mode-btn-icon">🐑</span>Normal
      </button>
      <button id="mpc-sport" class="mode-btn">
        <span class="mode-btn-icon">⚡</span>Sport
      </button>
    </div>
    <button class="mpc-disabled" disabled>
      <span class="mpc-icon">👥</span>
      <span>
        <span class="mpc-name">Play with Friends</span>
        <span class="mpc-desc"> · Coming soon</span>
      </span>
    </button>
  </div>
</div>

<button id="stats-btn" title="Leaderboard &amp; stats">☰</button>

<script is:inline>
(function() {
  const FIREBASE_DB_URL = 'https://sheep-game-4852f-default-rtdb.firebaseio.com/sheep-gates';
  const TEST_MODE  = new URLSearchParams(location.search).has('test')
                  || localStorage.getItem('sheepgate:god-mode') === '1';
  const SPORT_MODE = new URLSearchParams(location.search).has('sport');

  const GATES_PER_ROUND    = 7;
  const ROUNDS_PER_LEVEL   = 7;
  const FIELD_HEIGHT        = 320;
  const MAX_LEADERBOARD     = 5;
  // rainbowRoundChance loaded from Firebase config (_cfg._k)
  const RAINBOW_GATE_COLORS  = ['#e74c3c','#e67e22','#f1c40f','#2ecc71','#3498db','#9b59b6','#e91e8c'];
  const RAINBOW_BONUS_TYPES  = ['leg', 'clover', 'double'];

  // Game mechanics loaded from Firebase at boot — edit at firebase.google.com → your project → Realtime Database → /sheep-gates/config
  let _cfg = null;
  async function loadConfig() {
    try {
      const res = await fetch(`${FIREBASE_DB_URL}/config.json`);
      if (!res.ok) throw new Error(res.status);
      const d = await res.json();
      _cfg = Object.freeze({
        _a: d.sportTimerMs        ?? 8000,
        _b: d.hintChance          ?? 0.02,
        _c: d.sportTier1Ms        ?? 1000,
        _d: d.sportTier2Ms        ?? 2500,
        _e: d.sportTier3Ms        ?? 4000,
        _f: d.sportTier1Bonus     ?? 5,
        _g: d.sportTier2Bonus     ?? 3,
        _h: d.chickenLegChance    ?? 0.1,
        _i: d.cloverChance        ?? 0.1,
        _j: d.doubleScoreChance   ?? 0.1,
        _k: d.rainbowRoundChance  ?? 0.05,
        _l: d.doubleScoreDuration ?? 3,
        _m: d.basePoints          ?? 8,
        _n: d.basePointsPerLevel  ?? 2,
      });
    } catch(e) {
      console.warn('Config unavailable, using offline defaults');
      _cfg = Object.freeze({ _a:8000, _b:0.02, _c:1000, _d:2500, _e:4000, _f:5, _g:3, _h:0.1, _i:0.1, _j:0.1, _k:0.05, _l:3, _m:8, _n:2 });
    }
  }
  const GOD_MODE_KEY        = 'sheepgate:god-mode';
  const MUTE_KEY            = 'sheepgate:mute';
  const LOCAL_FALLBACK_KEY  = 'sheepgate:local-leaderboard';
  const SPORT_LB_KEY        = 'sheepgate:sport-leaderboard';
  const STATS_KEY           = 'sheepgate:stats';
  const PERSONAL_BEST_KEY   = 'sheepgate:personal-best';
  const ACHIEVEMENTS_KEY    = 'sheepgate:achievements';
  const SHEEP_TRANSITION = SPORT_MODE
    ? 'left 0.175s cubic-bezier(0.45, 0.05, 0.55, 0.95), bottom 0.175s cubic-bezier(0.45, 0.05, 0.55, 0.95), transform 0.075s, opacity 0.075s'
    : 'left 0.7s cubic-bezier(0.45, 0.05, 0.55, 0.95), bottom 0.7s cubic-bezier(0.45, 0.05, 0.55, 0.95), transform 0.3s, opacity 0.3s';
  const WORLD_TRANSITION = SPORT_MODE
    ? 'transform 0.4s cubic-bezier(0.4, 0.0, 0.2, 1)'
    : 'transform 1.6s cubic-bezier(0.4, 0.0, 0.2, 1)';

  // ---- Stats persistence -------------------------------------------------
  function loadStats() {
    try {
      return Object.assign(
        { gatesCleared:0, gamesPlayed:0, totalScore:0, bestLevel:1, hintsUsed:0, hintsFound:0, streakBest:0 },
        JSON.parse(localStorage.getItem(STATS_KEY))
      );
    } catch(_) {
      return { gatesCleared:0, gamesPlayed:0, totalScore:0, bestLevel:1, hintsUsed:0, hintsFound:0, streakBest:0 };
    }
  }
  function saveStats() {
    try { localStorage.setItem(STATS_KEY, JSON.stringify(stats)); } catch(_) {}
  }
  let stats = loadStats();

  let personalBest = parseInt(localStorage.getItem(PERSONAL_BEST_KEY)) || 0;

  // ---- Achievements -------------------------------------------------------
  const ACHIEVEMENTS = [
    { id: 'gate1',    icon: '🚪', label: 'First Step',       desc: 'Clear your first gate',         check: (s, st) => st.gatesCleared >= 1 },
    { id: 'level2',   icon: '📈', label: 'Leveling Up',      desc: 'Reach Level 2',                 check: (s, st) => st.bestLevel >= 2 },
    { id: 'level3',   icon: '🏅', label: 'Getting Serious',  desc: 'Reach Level 3',                 check: (s, st) => st.bestLevel >= 3 },
    { id: 'level5',   icon: '🌙', label: 'Night Shift',      desc: 'Reach Level 5',                 check: (s, st) => st.bestLevel >= 5 },
    { id: 'score10',  icon: '🐑', label: 'Ten Gates',        desc: 'Clear 10 gates in one run',     check: (s, st) => s.score >= 10 },
    { id: 'score25',  icon: '🏆', label: 'Quarter Century',  desc: 'Clear 25 gates in one run',     check: (s, st) => s.score >= 25 },
    { id: 'hintfound',icon: '🍗', label: 'Drumstick!',        desc: 'Find a chicken leg',            check: (s, st) => st.hintsFound >= 1 },
    { id: 'streak5',  icon: '🔥', label: 'Hot Streak',       desc: '5 gates in a row',              check: (s, st) => st.streakBest >= 5 },
    { id: 'games10',  icon: '🎮', label: 'Dedicated',        desc: 'Play 10 games',                 check: (s, st) => st.gamesPlayed >= 10 },
  ];
  let unlockedAchievements = new Set(
    JSON.parse(localStorage.getItem(ACHIEVEMENTS_KEY) || '[]')
  );
  function checkAchievements() {
    ACHIEVEMENTS.forEach(a => {
      if (!unlockedAchievements.has(a.id) && a.check(state, stats)) {
        unlockedAchievements.add(a.id);
        try { localStorage.setItem(ACHIEVEMENTS_KEY, JSON.stringify([...unlockedAchievements])); } catch(_) {}
        showAchievementToast(a);
      }
    });
  }
  let _toastQueue = [], _toastBusy = false;
  function showAchievementToast(a) {
    _toastQueue.push(a);
    if (!_toastBusy) drainToastQueue();
  }
  function drainToastQueue() {
    if (!_toastQueue.length) { _toastBusy = false; return; }
    _toastBusy = true;
    const a = _toastQueue.shift();
    const el = document.createElement('div');
    el.className = 'achievement-toast';
    el.innerHTML = '<span style="font-size:20px">' + a.icon + '</span>' +
      '<div><div class="ach-label">Achievement: ' + a.label + '</div>' +
      '<div class="ach-desc">' + a.desc + '</div></div>';
    document.body.appendChild(el);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('show')));
    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => { el.remove(); drainToastQueue(); }, 450);
    }, 3000);
  }

  // ---- Sport timer --------------------------------------------------------
  let _sportRaf = null;
  function startSportTimer() {
    cancelSportTimer();
    state.roundStartTime = performance.now();
    sportTimerEl.style.display = 'block';
    sportTimerBarEl.style.transform = 'scaleX(1)';
    (function tick() {
      const p = Math.max(0, 1 - (performance.now() - state.roundStartTime) / _cfg._a);
      sportTimerBarEl.style.transform = 'scaleX(' + p + ')';
      if (p <= 0) { autoKillBySport(); return; }
      _sportRaf = requestAnimationFrame(tick);
    })();
  }
  function cancelSportTimer() {
    if (_sportRaf) { cancelAnimationFrame(_sportRaf); _sportRaf = null; }
    sportTimerEl.style.display = 'none';
  }
  function autoKillBySport() {
    if (state.gameOver || state.animating) return;
    statusLabel.textContent = "⏱️ Time's up!";
    const idx = state.blockedGates[Math.floor(Math.random() * state.blockedGates.length)];
    pickGate(idx);
  }

  // ---- State --------------------------------------------------------------
  let state = {
    score: 0, gatesCleared: 0, blockedGates: [], animating: false,
    gameOver: false, chickenLegs: 0, luckyCloverCount: 0, doubleScoreRoundsLeft: 0, currentSetEl: null, worldOffset: 0,
    hintGateIdx: -1, hintCloverIdx: -1, hintDoubleScoreIdx: -1, streak: 0, roundStartTime: 0,
    rainbowRoundUsed: false, isRainbowRound: false, rainbowGateBonuses: []
  };

  let leaderboard = [];
  const PLAYER_NAME_KEY = 'sheepgate:player-name';
  let sessionName = localStorage.getItem(PLAYER_NAME_KEY) || '';
  let _wiggleId = null;

  const $ = id => document.getElementById(id);
  const worldEl             = $('world');
  const messageEl           = $('message');
  const sheepEl             = $('sheep');
  const sheepSvgEl          = $('sheep-svg');
  const sheepDeadEl         = $('sheep-dead');
  const sheepDeviousEl      = $('sheep-devious-face');
  const roundLabel          = $('round-label');
  const statusLabel         = $('status-label');
  const scoreEl             = $('score');
  const personalBestDisplay = $('personal-best-display');
  const levelLabel          = $('level-label');
  const levelProgressText   = $('level-progress-text');
  const levelProgressBar    = $('level-progress-bar');
  const streakRowEl         = $('streak-row');
  const chickenLegHudEl     = $('chicken-leg-hud');
  const luckyCloverHudEl    = $('lucky-clover-hud');
  const doubleScoreHudEl    = $('double-score-hud');
  const restartBtn          = $('restart-btn');
  const hiscoreEntry        = $('hiscore-entry');
  const hiscoreName         = $('hiscore-name');
  const hiscoreSave         = $('hiscore-save');
  const leaderboardEl       = $('leaderboard');
  const leaderboardList     = $('leaderboard-list');
  const fieldEl             = $('field');
  const levelBanner         = $('level-up-banner');
  const syncIndicator       = $('sync-indicator');
  const fieldOverlayEl      = $('field-overlay');
  const starsEl             = $('stars');
  const rainbowSkyEl        = $('rainbow-sky');
  const grassBladesEl       = $('grass-blades');
  const sportTimerEl        = $('sport-timer');
  const sportTimerBarEl     = $('sport-timer-bar');
  const statGatesEl         = $('stat-gates');
  const statGamesEl         = $('stat-games');
  const statAvgEl           = $('stat-avg');
  const statLevelEl         = $('stat-level');
  const statHintsUsedEl     = $('stat-hints-used');
  const statHintsFoundEl    = $('stat-hints-found');
  const statStreakEl        = $('stat-streak');
  const statPersonalBestEl  = $('stat-personal-best');

  // ---- Info drawer --------------------------------------------------------
  const infoDrawer  = $('info-drawer');
  const infoOverlay = $('info-overlay');
  function openDrawer()  { infoDrawer.classList.add('open');    infoOverlay.classList.add('open'); }
  function closeDrawer() { infoDrawer.classList.remove('open'); infoOverlay.classList.remove('open'); }
  $('stats-btn').onclick        = openDrawer;
  $('popup-stats-btn').onclick  = openDrawer;
  $('info-close').onclick  = closeDrawer;
  infoOverlay.onclick      = closeDrawer;

  function getLevel()        { return Math.floor(state.gatesCleared / ROUNDS_PER_LEVEL) + 1; }
  function getBlockedCount() { return Math.min(getLevel(), GATES_PER_ROUND - 1); }
  function getOpenCount()    { return GATES_PER_ROUND - getBlockedCount(); }
  function getRoundInLevel() { return (state.gatesCleared % ROUNDS_PER_LEVEL) + 1; }

  function renderStats() {
    statGatesEl.textContent        = stats.gatesCleared;
    statGamesEl.textContent        = stats.gamesPlayed;
    statAvgEl.textContent          = stats.gamesPlayed ? (stats.totalScore / stats.gamesPlayed).toFixed(1) : '—';
    statLevelEl.textContent        = stats.bestLevel;
    statHintsUsedEl.textContent    = stats.hintsUsed;
    statHintsFoundEl.textContent   = stats.hintsFound;
    statStreakEl.textContent        = stats.streakBest;
    statPersonalBestEl.textContent = personalBest || '—';
    personalBestDisplay.textContent = personalBest || '—';
  }

  // ---- Leaderboard --------------------------------------------------------
  const LB_LOCAL_KEY = SPORT_MODE ? SPORT_LB_KEY : LOCAL_FALLBACK_KEY;
  const LB_TITLE = SPORT_MODE ? '⚡ Sport Top 5' : 'Top 5 of all time';

  function setSyncStatus(text, kind) {
    syncIndicator.textContent = text || '';
    syncIndicator.className = 'sync-indicator' + (kind ? ' ' + kind : '');
  }
  function sanitizeLeaderboard(data) {
    if (!Array.isArray(data)) return [];
    return data.filter(entry =>
      entry &&
      typeof entry.name === 'string' &&
      /^[A-Z0-9 ]{1,10}$/.test(entry.name) &&
      Number.isFinite(entry.score) &&
      entry.score >= 0
    ).slice(0, MAX_LEADERBOARD);
  }
  function loadLocalLeaderboard() {
    try { leaderboard = sanitizeLeaderboard(JSON.parse(localStorage.getItem(LB_LOCAL_KEY))); }
    catch (_) { leaderboard = []; }
  }
  function saveLocalLeaderboard() {
    try { localStorage.setItem(LB_LOCAL_KEY, JSON.stringify(leaderboard)); } catch (_) {}
  }
  function extractScores(data) {
    if (!data) return [];
    const arr = data.scores ?? (Array.isArray(data) ? data : []);
    return sanitizeLeaderboard(arr);
  }
  async function loadLeaderboard() {
    if (SPORT_MODE) { loadLocalLeaderboard(); renderLeaderboard(); return; }
    setSyncStatus('Syncing...', 'syncing');
    try {
      const res = await fetch(`${FIREBASE_DB_URL}/leaderboard.json`);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      leaderboard = extractScores(await res.json());
      setSyncStatus('Synced', '');
    } catch (e) {
      console.error('Failed to load leaderboard', e);
      setSyncStatus('Offline', 'error');
    }
    if (leaderboard.length === 0) loadLocalLeaderboard();
    renderLeaderboard();
  }
  async function saveLeaderboard() {
    if (SPORT_MODE) {
      leaderboard.sort((a, b) => b.score - a.score);
      leaderboard = leaderboard.slice(0, MAX_LEADERBOARD);
      saveLocalLeaderboard(); renderLeaderboard(); return true;
    }
    setSyncStatus('Saving...', 'syncing');
    try {
      const latestRes = await fetch(`${FIREBASE_DB_URL}/leaderboard.json`);
      let serverScores = [];
      if (latestRes.ok) serverScores = extractScores(await latestRes.json());
      const combined = [...serverScores, ...leaderboard];
      const seen = new Set();
      const merged = [];
      for (const entry of combined) {
        const key = entry.name + '|' + entry.score + '|' + (entry.date || '');
        if (!seen.has(key)) { seen.add(key); merged.push(entry); }
      }
      merged.sort((a, b) => b.score - a.score);
      const trimmed = merged.slice(0, MAX_LEADERBOARD);
      const putRes = await fetch(`${FIREBASE_DB_URL}/leaderboard.json`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ scores: trimmed })
      });
      if (!putRes.ok) throw new Error('HTTP ' + putRes.status);
      leaderboard = trimmed;
      try { localStorage.setItem(LOCAL_FALLBACK_KEY, JSON.stringify(leaderboard)); } catch (_) {}
      setSyncStatus('Synced', '');
      return true;
    } catch (e) {
      console.error('Failed to save leaderboard', e);
      setSyncStatus('Save failed', 'error');
      try { localStorage.setItem(LOCAL_FALLBACK_KEY, JSON.stringify(leaderboard)); } catch (_) {}
      return false;
    }
  }
  function isNewBest(score) {
    if (leaderboard.length < MAX_LEADERBOARD) return score > 0;
    return score > leaderboard[leaderboard.length - 1].score;
  }
  function renderLeaderboard() {
