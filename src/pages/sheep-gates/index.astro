  // ---- Gate building ------------------------------------------------------
  function pickBlockedIndices(count, rng) {
    rng = rng || Math.random;
    const indices = [], pool = Array.from({ length: GATES_PER_ROUND }, (_, i) => i);
    for (let n = 0; n < count; n++) {
      const idx = Math.floor(rng() * pool.length);
      indices.push(pool[idx]); pool.splice(idx, 1);
    }
    return indices;
  }
