  function playCloverFound() {
    _tone(523,  'sine', 0.11, 0,    0.25);
    _tone(659,  'sine', 0.10, 0.08, 0.25);
    _tone(784,  'sine', 0.09, 0.16, 0.25);
    _tone(1047, 'sine', 0.08, 0.26, 0.38);
  }
  function playCloverActivate() {
    _tone(392,  'sine', 0.10, 0,    0.18);
    _tone(523,  'sine', 0.12, 0.09, 0.18);
    _tone(659,  'sine', 0.11, 0.18, 0.18);
    _tone(784,  'sine', 0.10, 0.27, 0.22);
    _tone(1047, 'sine', 0.08, 0.38, 0.40);
  }

  // ---- Pickup discovery (shared by chicken leg & lucky clover) -----------
  function updateChickenLegHud() {
    const n = state.chickenLegs;
    chickenLegHudEl.style.display = n > 0 ? 'block' : 'none';
    chickenLegHudEl.textContent = n > 1 ? '🍗×' + n : '🍗';
  }
  function updateLuckyCloverHud() {
    const n = state.luckyCloverCount;
    luckyCloverHudEl.style.display = n > 0 ? 'block' : 'none';
    luckyCloverHudEl.textContent = n > 1 ? '🍀×' + n : '🍀';
  }
  const PICKUP_POP_CSS = 'position:absolute;top:50%;left:50%;font-size:30px;z-index:5;pointer-events:none;transform:translate(-50%,-50%) scale(0);opacity:0;transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1),opacity 0.2s;';
  function tryGrantPickup(gateEl, index, stateKey, hintKey, hudUpdate, emoji, sound, onGrant) {
    if (state[hintKey] < 0 || index !== state[hintKey]) return false;
    if (onGrant) onGrant();
    state[stateKey]++;
    hudUpdate();
    showPickupPop(gateEl, emoji, sound);
    fieldEl.classList.add('shaking-small');
    setTimeout(() => fieldEl.classList.remove('shaking-small'), 320);
    return true;
  }
  function tryGrantChickenLeg(gateEl, index) {
    return tryGrantPickup(gateEl, index, 'chickenLegs', 'hintGateIdx', updateChickenLegHud, '🍗', playHintFound, () => stats.hintsFound++);
  }
  function tryGrantLuckyClover(gateEl, index) {
    return tryGrantPickup(gateEl, index, 'luckyCloverCount', 'hintCloverIdx', updateLuckyCloverHud, '🍀', playCloverFound, null);
  }
  function updateDoubleScoreHud() {
    if (state.doubleScoreRoundsLeft > 0) {
      doubleScoreHudEl.textContent = '2X';
      doubleScoreHudEl.style.display = 'block';
    } else {
      doubleScoreHudEl.style.display = 'none';
    }
  }
  function playDoubleScoreFound() {
    _tone(523,  'sine', 0.09, 0,    0.15);
    _tone(784,  'sine', 0.09, 0.08, 0.15);
    _tone(1047, 'sine', 0.09, 0.16, 0.15);
    _tone(1319, 'sine', 0.10, 0.26, 0.15);
    _tone(1568, 'sine', 0.08, 0.38, 0.40);
  }
  const DOUBLE_SCORE_POP_STYLE = 'color:#ffd700;font-weight:900;font-size:24px;text-shadow:0 0 12px rgba(255,200,0,0.9),0 2px 4px rgba(0,0,0,0.5);';
  function tryGrantDoubleScore(gateEl, index) {
    if (state.hintDoubleScoreIdx < 0 || index !== state.hintDoubleScoreIdx) return false;
    state.doubleScoreRoundsLeft += 3;
    updateDoubleScoreHud();
    showPickupPop(gateEl, '2X', playDoubleScoreFound, DOUBLE_SCORE_POP_STYLE);
    fieldEl.classList.add('shaking-small');
    setTimeout(() => fieldEl.classList.remove('shaking-small'), 320);
    return true;
  }

  // ---- Lucky Clover activation --------------------------------------------
  function activateLuckyClover() {
    if (!state.luckyCloverCount || state.gameOver || state.animating) return;
    if (state.blockedGates.length === 0) return;

    state.luckyCloverCount = Math.max(0, state.luckyCloverCount - 1);
    updateLuckyCloverHud();

    const targetGateIdx = state.blockedGates[Math.floor(Math.random() * state.blockedGates.length)];
    const gates     = state.currentSetEl.querySelectorAll('.gate');
    const targetEl  = gates[targetGateIdx];
    const wrapEl    = targetEl.parentNode;

    const fieldRect  = fieldEl.getBoundingClientRect();
    const cloverRect = luckyCloverHudEl.getBoundingClientRect();
    const gateRect   = targetEl.getBoundingClientRect();
    const endX   = gateRect.left  - fieldRect.left + gateRect.width  / 2;
    const endY   = gateRect.top   - fieldRect.top  + gateRect.height / 2;
    const startX = cloverRect.left - fieldRect.left + cloverRect.width  / 2;
    const startY = cloverRect.top  - fieldRect.top  + cloverRect.height / 2;

    statusLabel.textContent = '🍀 Chasing away a wolf…';
    playCloverActivate();

    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:absolute;inset:0;background:rgba(100,18,18,0.80);z-index:6;display:flex;align-items:center;justify-content:center;font-size:24px;pointer-events:none;border-radius:0 4px 4px 0;transform:scale(0);opacity:0;transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1),opacity 0.2s;';
    overlay.textContent = '🐺';
    targetEl.appendChild(overlay);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      overlay.style.transform = 'scale(1)';
      overlay.style.opacity   = '1';
    }));

    setTimeout(() => {
      const fly = document.createElement('div');
      fly.className = 'flying-clover';
      fly.textContent = '🍀';
      fly.style.left       = startX + 'px';
      fly.style.top        = startY + 'px';
      fly.style.transition = 'left 0.46s cubic-bezier(0.4,0,0.2,1), top 0.46s cubic-bezier(0.4,0,0.2,1), transform 0.46s';
      fieldEl.appendChild(fly);
      fly.getBoundingClientRect();
      fly.style.left      = endX + 'px';
      fly.style.top       = endY + 'px';
      fly.style.transform = 'translate(-50%,-50%) rotate(360deg) scale(1.3)';

      setTimeout(() => {
        overlay.style.transition = 'transform 0.32s ease-in, opacity 0.32s ease-in';
        overlay.style.transform  = 'scale(0)';
        overlay.style.opacity    = '0';
        fly.style.transition     = 'transform 0.32s ease-in, opacity 0.32s ease-in';
        fly.style.transform      = 'translate(-50%,-50%) scale(0) rotate(180deg)';
        fly.style.opacity        = '0';

        setTimeout(() => {
          fly.remove();
          overlay.remove();

          const idx = state.blockedGates.indexOf(targetGateIdx);
          if (idx !== -1) state.blockedGates.splice(idx, 1);

          wrapEl.querySelectorAll('.test-mark-wolf').forEach(m => m.remove());

          spawnFloatingScore(targetEl, '🍀');
          statusLabel.textContent = '🍀 Wolf scared away!';
          setTimeout(() => {
            if (!state.gameOver) statusLabel.textContent = 'Pick the open gate';
          }, 1800);
        }, 340);
      }, 480);
    }, 300);
  }
  luckyCloverHudEl.onclick = activateLuckyClover;

  // ---- Walk to next round (shared between success and wolf-fed paths) ----
  function walkToNextRound(wasLevelUp) {
    const _D = SPORT_MODE ? 0.25 : 1;
    setTimeout(() => {
      statusLabel.textContent = 'Walking on...';
      sheepEl.style.animation = 'sheep-bob 360ms linear infinite';
      state.currentSetEl.style.transition = 'opacity 0.5s ease-out';
      state.currentSetEl.style.opacity = '0';
      state.worldOffset += FIELD_HEIGHT;
      worldEl.style.transform = 'translateY(' + state.worldOffset + 'px)';

      const nextBlocked = pickBlockedIndices(getBlockedCount());
      const open = Array.from({length: GATES_PER_ROUND}, (_, i) => i)
        .filter(i => !nextBlocked.includes(i));
      const legChance = TEST_MODE ? 1 : (_cfg._h ?? 1/10);
      const clovChance = TEST_MODE ? 1 : (_cfg._i ?? 1/10);
      const dblChance  = TEST_MODE ? 1 : (_cfg._j ?? 1/10);
      const nextHintIdx = (Math.random() < legChance)
        ? open[Math.floor(Math.random() * open.length)] : -1;
      const openForClover = nextHintIdx >= 0 ? open.filter(i => i !== nextHintIdx) : open;
      const nextCloverIdx = (Math.random() < clovChance)
        ? (openForClover.length > 0 ? openForClover[Math.floor(Math.random() * openForClover.length)] : -1) : -1;
      const openForDouble = nextCloverIdx >= 0 ? openForClover.filter(i => i !== nextCloverIdx) : openForClover;
      const nextDoubleScoreIdx = (Math.random() < dblChance)
        ? (openForDouble.length > 0 ? openForDouble[Math.floor(Math.random() * openForDouble.length)] : -1) : -1;

      const nextSet = buildGateSet(95 - state.worldOffset);
      worldEl.appendChild(nextSet);

      if (TEST_MODE) {
        const gates = nextSet.querySelectorAll('.gate');
        nextBlocked.forEach(idx => stampTestMark(gates, idx, '🐺'));
        if (nextHintIdx >= 0)    stampTestMark(gates, nextHintIdx, '🍗');
        if (nextCloverIdx >= 0)  stampTestMark(gates, nextCloverIdx, '🍀');
        if (nextDoubleScoreIdx >= 0)                       stampTestMark(gates, nextDoubleScoreIdx, '2X');
      }

      setTimeout(() => {
        sheepEl.style.animation = '';
        sheepEl.style.transform = 'translateX(-50%)';
        if (state.currentSetEl && state.currentSetEl.parentNode === worldEl)
          worldEl.removeChild(state.currentSetEl);
        state.currentSetEl = nextSet;
        sheepEl.classList.remove('walking');
        sheepEl.style.transition = `bottom ${0.5 * _D}s ease, transform ${0.3 * _D}s, opacity ${0.3 * _D}s`;
        sheepEl.style.bottom = '24px';
        setTimeout(() => {
          sheepEl.style.transition = SHEEP_TRANSITION;
          state.blockedGates       = nextBlocked;
          state.hintGateIdx        = nextHintIdx;
          state.hintCloverIdx      = nextCloverIdx;
          state.hintDoubleScoreIdx = nextDoubleScoreIdx;
          state.animating = false;
          statusLabel.textContent = 'Pick the open gate';
          if (wasLevelUp) showLevelUp(getLevel());
          if (SPORT_MODE) startSportTimer();
        }, 550 * _D);
      }, 1500 * _D);
    }, 500 * _D);
  }

  // ---- Feed the wolf (survive using chicken leg) -------------------------
  function feedWolf(gateEl, alreadyOpen, wolfRevealEl) {
    state.chickenLegs = Math.max(0, state.chickenLegs - 1);
    stats.hintsUsed++;
    saveStats();

    const fieldRect = fieldEl.getBoundingClientRect();
    const hudRect   = chickenLegHudEl.getBoundingClientRect();
    const gateRect  = gateEl.getBoundingClientRect();
    const gx = gateRect.left - fieldRect.left + gateRect.width  / 2;
    const gy = gateRect.top  - fieldRect.top  + gateRect.height / 2;

    updateChickenLegHud();
    statusLabel.textContent = '🐺 The wolf lurks…';
    navigator.vibrate && navigator.vibrate([30, 20, 60]);
    playWolfGrowl();

    if (!alreadyOpen) {
      gateEl.style.transition = 'transform 0.4s cubic-bezier(0.4,0,0.2,1), background 0.25s';
      gateEl.style.background = '#7b1a1a';
      gateEl.style.transform  = 'rotateY(-28deg)';
    }

    setTimeout(() => {
      let wolfPop;
      if (wolfRevealEl) {
        wolfPop = wolfRevealEl;
        wolfPop.style.zIndex = '12';
      } else {
        wolfPop = document.createElement('div');
        wolfPop.className   = 'funny-skull pop';
        wolfPop.style.left  = gx + 'px';
        wolfPop.style.top   = gy + 'px';
        wolfPop.style.zIndex = '12';
        wolfPop.innerHTML   = _WOLF_SVG;
        fieldEl.appendChild(wolfPop);
      }

      statusLabel.textContent = '🍗 Feeding the wolf…';

      setTimeout(() => {
        const startX = hudRect.left - fieldRect.left + hudRect.width  / 2;
        const startY = hudRect.top  - fieldRect.top  + hudRect.height / 2;

        const fly = document.createElement('div');
        fly.className = 'flying-drumstick';
        fly.textContent = '🍗';
        fly.style.left = startX + 'px';
        fly.style.top  = startY + 'px';
        fly.style.transition = 'left 0.42s cubic-bezier(0.4,0,0.2,1), top 0.42s cubic-bezier(0.4,0,0.2,1), transform 0.42s';
        fieldEl.appendChild(fly);
        fly.getBoundingClientRect();
        fly.style.left      = gx + 'px';
        fly.style.top       = gy + 'px';
        fly.style.transform = 'translate(-50%,-50%) scale(1.3) rotate(40deg)';

        setTimeout(() => {
          fly.style.transition = 'transform 0.1s, opacity 0.1s';
          fly.style.transform  = 'translate(-50%,-50%) scale(0)';
          fly.style.opacity    = '0';

          playWolfChomp();
          const snap = document.createElement('div');
          snap.className = 'wolf-snap-anim';
          snap.textContent = '🐺';
          gateEl.parentNode.appendChild(snap);

          setTimeout(() => {
            fly.remove();
            snap.remove();
            wolfPop.remove();

            gateEl.style.transition = 'background 0.15s, transform 0.5s cubic-bezier(0.34,1.56,0.64,1)';
            gateEl.style.background = '#e65100';
            statusLabel.textContent = '🍗 The wolf is fed — keep going!';
            playGateOpen();
            spawnFloatingScore(gateEl, '🍗');
            setTimeout(() => {
              gateEl.style.background = '';
              gateEl.style.transform  = 'rotateY(-110deg)';
            }, 150);

            sheepDeviousEl.setAttribute('display', 'block');
            setTimeout(() => sheepDeviousEl.setAttribute('display', 'none'), 3200);

            updateHud();
            checkAchievements();
            walkToNextRound(false);
          }, 400);
        }, 430);
      }, 40);
    }, alreadyOpen ? 0 : 420);
  }

  // ---- Gate interaction --------------------------------------------------
  function pickGate(index) {
    if (state.gameOver || state.animating) return;
    if (SPORT_MODE) cancelSportTimer();
    state.sportClickElapsed = SPORT_MODE ? performance.now() - state.roundStartTime : 0;
    state.animating = true;

    const gates = state.currentSetEl.querySelectorAll('.gate');
    gates.forEach(g => {
      g.disabled = true;
      g.onmouseover = null; g.onmouseout = null; g.onclick = null;
      g.style.cursor = 'default'; g.style.transform = 'translateY(0)';
    });

    const gateEl = gates[index];
    const gateRect = gateEl.getBoundingClientRect();
    const fieldRect = fieldEl.getBoundingClientRect();
    const leftPct = ((gateRect.left - fieldRect.left + gateRect.width / 2) / fieldRect.width) * 100;

    const isBlocked = state.blockedGates.indexOf(index) !== -1;

    statusLabel.textContent = 'Trotting over...';
    const _curLeft = parseFloat(sheepEl.style.left) || 50;
    sheepSvgEl.style.transform = leftPct > _curLeft ? 'scaleX(-1)' : 'scaleX(1)';
    sheepEl.style.left = leftPct + '%';
    sheepEl.classList.add('walking');

    const walkMs = SPORT_MODE ? 175 : 700;
    const upMs   = SPORT_MODE ? 175 : 700;

    let wiggleCount = 0;
    _wiggleId = setInterval(() => {
      sheepEl.style.transform = 'translateX(-50%) rotate(' + (wiggleCount % 2 === 0 ? '-6deg' : '6deg') + ')';
      if (wiggleCount % 2 === 0) playSheepStep();
      wiggleCount++;
    }, 120);

    setTimeout(() => {
      clearInterval(_wiggleId); _wiggleId = null;
      sheepEl.style.transform = 'translateX(-50%)';
      sheepEl.style.bottom = '80px';

      let _wolfRevealEl = null;

      setTimeout(() => {
        gateEl.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
        gateEl.style.transform  = 'rotateY(-110deg)';
        if (!isBlocked) {
          playGateOpen();
        } else {
          const gr = gateEl.getBoundingClientRect(), fr = fieldEl.getBoundingClientRect();
          _wolfRevealEl = document.createElement('div');
          _wolfRevealEl.className = 'funny-skull';
          _wolfRevealEl.style.left = (gr.left - fr.left + gr.width  / 2) + 'px';
          _wolfRevealEl.style.top  = (gr.top  - fr.top  + gr.height / 2) + 'px';
          _wolfRevealEl.innerHTML  = _WOLF_SVG;
          fieldEl.appendChild(_wolfRevealEl);
          requestAnimationFrame(() => requestAnimationFrame(() => _wolfRevealEl.classList.add('pop')));
        }
      }, upMs / 2);

      setTimeout(() => resolveGate(index, gateEl, true, _wolfRevealEl), upMs + 80);
    }, walkMs);
  }

  function resolveGate(index, gateEl, alreadyOpened, wolfRevealEl) {
    const isBlocked = state.blockedGates.indexOf(index) !== -1;
    if (!isBlocked) {
      if (!alreadyOpened) {
        gateEl.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
        gateEl.style.transform = 'rotateY(-110deg)';
        playGateOpen();
      }
      showNearMiss(state.currentSetEl, state.blockedGates);
      navigator.vibrate && navigator.vibrate(25);
      const _scoreBefore = state.score;
      const _level = getLevel();
      const _basePoints = _cfg._m + _level * _cfg._n;
      state.score += _basePoints;
      state.gatesCleared++;
      state.streak++;

      let floatLabel = '+' + _basePoints;
      if (SPORT_MODE) {
        const elapsed = state.sportClickElapsed;
        if (elapsed < _cfg._c) {
          state.score += _cfg._f; floatLabel = '+' + (_basePoints + _cfg._f) + ' ⚡⚡';
        } else if (elapsed < _cfg._d) {
          state.score += _cfg._g; floatLabel = '+' + (_basePoints + _cfg._g) + ' ⚡';
        }
      }

      if (state.doubleScoreRoundsLeft > 0) {
        const gained = state.score - _scoreBefore;
        state.score += gained;
        state.doubleScoreRoundsLeft--;
        const doubled = gained * 2;
        if (floatLabel.includes('⚡⚡')) floatLabel = '+' + doubled + ' ⚡⚡ ×2';
        else if (floatLabel.includes('⚡')) floatLabel = '+' + doubled + ' ⚡ ×2';
        else floatLabel = '+' + doubled + ' ×2';
        updateDoubleScoreHud();
      }

      if (state.isRainbowRound) {
        grantRainbowBonus(gateEl, index);
      } else {
        tryGrantChickenLeg(gateEl, index);
        tryGrantLuckyClover(gateEl, index);
        tryGrantDoubleScore(gateEl, index);
      }

      spawnFloatingScore(gateEl, floatLabel);
      const wasLevelUp = (state.gatesCleared % ROUNDS_PER_LEVEL === 0);
      updateHud();
      checkAchievements();
      walkToNextRound(wasLevelUp);

    } else {
      if (state.chickenLegs > 0) { feedWolf(gateEl, alreadyOpened, wolfRevealEl); return; }
      playGateCrash();
      navigator.vibrate && navigator.vibrate([70, 40, 70]);
      spawnCrashParticles(gateEl);
      fieldEl.classList.add('shaking');
      setTimeout(() => fieldEl.classList.remove('shaking'), 520);
      if (!alreadyOpened) {
        gateEl.style.transformOrigin = 'left bottom';
        gateEl.style.transition = 'transform 0.7s cubic-bezier(0.55, 0.085, 0.68, 0.53), background 0.4s, border-color 0.4s';
        gateEl.style.background = '#a33c1d';
        gateEl.style.borderColor = '#712b13';
        gateEl.style.zIndex = '4';
        gateEl.style.transform = 'rotate(-3deg)';
        setTimeout(() => { gateEl.style.transform = 'rotate(2deg)'; }, 150);
        setTimeout(() => { gateEl.style.transform = 'rotate(90deg)'; }, 350);
      }
      setTimeout(() => {
        sheepEl.classList.remove('walking');
        sheepEl.style.transition = 'all 0.4s ease-out';
        sheepEl.style.transform = 'translateX(-50%) translateY(8px) scaleY(0.4) scaleX(1.4)';
      }, 700);
      if (!wolfRevealEl) spawnFunnySkull(gateEl);
      setTimeout(() => {
        sheepEl.style.transition = 'opacity 0.4s';
        sheepEl.style.opacity = '0';
        handleEndOfGame();
      }, 1300);
    }
  }

  function handleEndOfGame() {
    cancelSportTimer();
    state.animating = false; state.gameOver = true;

    stats.gamesPlayed++;
    stats.totalScore += state.score;
    stats.gatesCleared += state.gatesCleared;
    stats.bestLevel = Math.max(stats.bestLevel, getLevel());
    stats.streakBest = Math.max(stats.streakBest, state.streak);
    saveStats();

    if (state.score > personalBest) {
      personalBest = state.score;
      try { localStorage.setItem(PERSONAL_BEST_KEY, personalBest); } catch(_) {}
    }

    renderStats();
    checkAchievements();

    messageEl.textContent = 'Squashed at gate ' + (state.gatesCleared + 1) + '.';
    messageEl.style.color = 'var(--danger)';
    statusLabel.textContent = 'Game over · cleared ' + state.gatesCleared + ' gate' + (state.gatesCleared === 1 ? '' : 's');

    if (!TEST_MODE && isNewBest(state.score)) {
      if (sessionName) autoSaveScore(); else showHiscoreEntry();
    } else {
      showModePopup(true);
    }
  }
  function showHiscoreEntry() {
    hiscoreEntry.style.display = 'block';
    hiscoreName.value = sessionName;
    hiscoreName.select();
    setTimeout(() => hiscoreName.focus(), 100);
  }
  async function pushScore(name) {
    leaderboard.push({ name, score: state.score, date: new Date().toISOString() });
    leaderboard.sort((a, b) => b.score - a.score);
    leaderboard = leaderboard.slice(0, MAX_LEADERBOARD);
    renderLeaderboard();
    await saveLeaderboard();
  }
  async function autoSaveScore() {
    await pushScore(sessionName);
    showAchievementToast({ icon: '🏆', label: 'Score saved', desc: 'as ' + sessionName });
    showModePopup(true);
  }
  hiscoreSave.onclick = async () => {
    let name = (hiscoreName.value || '').toUpperCase().replace(/[^A-Z0-9 ]/g, '').trim().slice(0, 10);
    if (name.length === 0) name = 'ANON';
    sessionName = name;
    localStorage.setItem(PLAYER_NAME_KEY, name);
    await pushScore(name);
    hiscoreEntry.style.display = 'none';
    showModePopup(true);
  };
  hiscoreName.addEventListener('input', e => {
    e.target.value = e.target.value.toUpperCase().replace(/[^A-Z0-9 ]/g, '').slice(0, 10);
  });
  hiscoreName.addEventListener('keydown', e => { if (e.key === 'Enter') hiscoreSave.click(); });

  const modeOverlayEl  = document.getElementById('mode-overlay');
  const modeResultEl   = document.getElementById('mode-popup-result');
  const modeScoreValEl = document.getElementById('mode-popup-score-val');
  const modeScoreSubEl = document.getElementById('mode-popup-score-sub');
  const modePopupSubEl = document.getElementById('mode-popup-sub');

  function showModePopup(afterGame) {
    if (afterGame) {
      modeResultEl.style.display = 'block';
      modeScoreValEl.textContent = state.score + ' pts';
      modeScoreSubEl.textContent = state.gatesCleared + ' gate' + (state.gatesCleared === 1 ? '' : 's') + ' cleared';
      modePopupSubEl.textContent = 'Play again?';
    } else {
      modeResultEl.style.display = 'none';
      modePopupSubEl.textContent = 'Choose your mode';
    }
    modeOverlayEl.style.display = 'flex';
  }

  function hideModePopup() { modeOverlayEl.style.display = 'none'; }

  function switchMode(toSport) {
    sessionStorage.setItem('sheepgate:autostart', '1');
    const url = new URL(location.href);
    url.searchParams.delete('sport');
    if (toSport) url.searchParams.set('sport', '');
    location.href = url.toString();
  }

  document.getElementById('mpc-normal').addEventListener('click', () => {
    if (SPORT_MODE) switchMode(false); else { hideModePopup(); doRestart(); }
  });
  document.getElementById('mpc-sport').addEventListener('click', () => {
    if (!SPORT_MODE) switchMode(true); else { hideModePopup(); doRestart(); }
  });

  function doRestart() {
    cancelSportTimer();
    clearInterval(_wiggleId); _wiggleId = null;
    sheepEl.style.animation = '';
    sheepEl.classList.remove('walking');
    showSheep();
    state = {
      score: 0, gatesCleared: 0, blockedGates: [], animating: false,
      gameOver: false, chickenLegs: 0, luckyCloverCount: 0, doubleScoreRoundsLeft: 0, currentSetEl: null, worldOffset: 0,
      hintGateIdx: -1, hintCloverIdx: -1, hintDoubleScoreIdx: -1, streak: 0, roundStartTime: 0, sportClickElapsed: 0,
      rainbowRoundUsed: false, isRainbowRound: false, rainbowGateBonuses: []
    };
    updateChickenLegHud();
    updateLuckyCloverHud();
    updateDoubleScoreHud();
    sheepDeviousEl.setAttribute('display', 'none');
    worldEl.innerHTML = '';
    fieldEl.querySelectorAll('.funny-skull').forEach(el => el.remove());
    worldEl.style.transition = 'none';
    worldEl.style.transform = 'translateY(0)';
    sheepEl.style.transition = 'none';
    sheepEl.style.left = '50%';
    sheepEl.style.bottom = '24px';
    sheepEl.style.transform = 'translateX(-50%)';
    sheepSvgEl.style.transform = 'scaleX(1)';
    sheepEl.style.opacity = '1';
    fieldOverlayEl.style.background = 'transparent';
    starsEl.style.opacity = '0';
    rainbowSkyEl.style.opacity = '0';
    setTimeout(() => {
      worldEl.style.transition = WORLD_TRANSITION;
      sheepEl.style.transition = SHEEP_TRANSITION;
      loadLeaderboard();
      newRound();
    }, 30);
  }

  restartBtn.onclick = doRestart;

  // ---- World generation --------------------------------------------------
  function generateGrassBlades() {
    for (let i = 0; i < 24; i++) {
      const b = document.createElement('div');
      b.className = 'grass-blade';
      b.style.left = (i / 24 * 100 + Math.random() * 2) + '%';
      b.style.height = (12 + Math.random() * 10) + 'px';
      b.style.animationDelay  = (Math.random() * 2) + 's';
      b.style.animationDuration = (1.4 + Math.random() * 1.2) + 's';
      grassBladesEl.appendChild(b);
    }
  }
  function generateStars() {
    for (let i = 0; i < 28; i++) {
      const s = document.createElement('div');
      s.className = 'star';
      s.style.left = (Math.random() * 100) + '%';
      s.style.top  = (Math.random() * 90)  + '%';
      s.style.animationDelay = (Math.random() * 3) + 's';
      s.style.animationDuration = (1.5 + Math.random() * 2) + 's';
      if (Math.random() < 0.3) { s.style.width = '3px'; s.style.height = '3px'; }
      starsEl.appendChild(s);
    }
  }

  // ---- Boot --------------------------------------------------------------
  if (TEST_MODE)  $('test-badge').style.display  = 'inline-block';
  if (MUTED)      $('mute-badge').style.display  = 'inline-block';
  const godToggleEl = $('god-mode-toggle');
  godToggleEl.textContent = TEST_MODE ? 'ON' : 'OFF';
  godToggleEl.style.color = TEST_MODE ? 'var(--success)' : 'var(--text-secondary)';
  godToggleEl.onclick = () => {
    if (TEST_MODE) localStorage.removeItem(GOD_MODE_KEY);
    else           localStorage.setItem(GOD_MODE_KEY, '1');
    location.reload();
  };
  const muteToggleEl = $('mute-toggle');
  muteToggleEl.textContent = MUTED ? 'ON' : 'OFF';
  muteToggleEl.style.color = MUTED ? 'var(--success)' : 'var(--text-secondary)';
  muteToggleEl.onclick = () => {
    MUTED = !MUTED;
    if (MUTED) localStorage.setItem(MUTE_KEY, '1');
    else       localStorage.removeItem(MUTE_KEY);
    muteToggleEl.textContent = MUTED ? 'ON' : 'OFF';
    muteToggleEl.style.color = MUTED ? 'var(--success)' : 'var(--text-secondary)';
    $('mute-badge').style.display = MUTED ? 'inline-block' : 'none';
  };
  if (SPORT_MODE) {
    $('sport-badge').style.display = 'inline-block';
    syncIndicator.style.display = 'none';
    document.body.classList.add('sport-mode');
    const _sportSheepSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 70 58" width="35" height="29" style="vertical-align:-3px;margin-right:1px">
      <circle cx="38" cy="26" r="17" fill="#eeeae0"/>
      <circle cx="27" cy="21" r="12" fill="#f3f1e8"/>
      <circle cx="44" cy="19" r="12" fill="#edeae2"/>
      <circle cx="51" cy="27" r="10" fill="#e9e6dc"/>
      <circle cx="28" cy="33" r="10" fill="#e9e6dc"/>
      <circle cx="41" cy="34" r="8"  fill="#e6e3d9"/>
      <ellipse cx="13" cy="33" rx="10" ry="9" fill="#d5caaf"/>
      <ellipse cx="6"  cy="37" rx="5"  ry="4" fill="#c9bda0"/>
      <circle cx="4.5" cy="38.5" r="1.1" fill="#9c8c74"/>
      <circle cx="7.5" cy="38.5" r="1.1" fill="#9c8c74"/>
      <g class="leg leg-bl"><rect x="49" y="42" width="6" height="13" rx="3"   fill="#c2b89a"/><rect x="49" y="51" width="6" height="5" rx="2" fill="#3a2e1e"/></g>
      <g class="leg leg-br"><rect x="55" y="42" width="5" height="13" rx="2.5" fill="#b4aa8c"/><rect x="55" y="51" width="5" height="5" rx="2" fill="#2e2418"/></g>
      <g class="leg leg-fl"><rect x="26" y="42" width="6" height="13" rx="3"   fill="#cac0a0"/><rect x="26" y="51" width="6" height="5" rx="2" fill="#3a2e1e"/></g>
      <g class="leg leg-fr"><rect x="33" y="42" width="5" height="13" rx="2.5" fill="#bcb294"/><rect x="33" y="51" width="5" height="5" rx="2" fill="#2e2418"/></g>
      <path d="M2,34 C2,16 26,16 26,34 Z" fill="#b71c1c"/>
      <path d="M14,16 C21,16 26,23 26,34 L21,34 C21,25 18,18 14,16 Z" fill="#8b0000"/>
      <path d="M13.5,16 L13.5,34" stroke="#ffd600" stroke-width="2" fill="none"/>
      <path d="M2,34 C0,42 5,44 13,43" stroke="#7b0000" stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <line x1="5"   y1="28" x2="4"   y2="41" stroke="#888" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="9"   y1="27" x2="8"   y2="39" stroke="#888" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="3.8" y1="33" x2="8.5" y2="32" stroke="#888" stroke-width="1.0" stroke-linecap="round"/>
      <circle cx="11"  cy="30"   r="2.2" fill="#1e1810"/>
      <circle cx="10.2" cy="29.2" r="0.6" fill="white"/>
    </svg>`;
    $('title-sheep').innerHTML = _sportSheepSVG;
    const _favLink = document.querySelector('link[rel="icon"]');
    if (_favLink) _favLink.href = "data:image/svg+xml," + encodeURIComponent(
      `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 70 58'>` +
      `<circle cx='38' cy='26' r='17' fill='%23eeeae0'/>` +
      `<circle cx='27' cy='21' r='12' fill='%23f3f1e8'/>` +
      `<circle cx='44' cy='19' r='12' fill='%23edeae2'/>` +
      `<circle cx='51' cy='27' r='10' fill='%23e9e6dc'/>` +
      `<circle cx='28' cy='33' r='10' fill='%23e9e6dc'/>` +
      `<ellipse cx='13' cy='33' rx='10' ry='9' fill='%23d5caaf'/>` +
      `<ellipse cx='6' cy='37' rx='5' ry='4' fill='%23c9bda0'/>` +
      `<path d='M2,34 C2,16 26,16 26,34 Z' fill='%23b71c1c'/>` +
      `<path d='M14,16 C21,16 26,23 26,34 L21,34 C21,25 18,18 14,16Z' fill='%238b0000'/>` +
      `<path d='M13.5,16 L13.5,34' stroke='%23ffd600' stroke-width='2' fill='none'/>` +
      `<circle cx='11' cy='30' r='2.5' fill='%231e1810'/>` +
      `</svg>`
    );
    document.getElementById('sheep-sport-bolt').setAttribute('display', 'block');
  }

  generateGrassBlades();
  generateStars();
  updateFieldAmbience(1);
  renderStats();
  statusLabel.textContent = 'Loading...';
  loadConfig().then(() => {
    loadLeaderboard();
    if (sessionStorage.getItem('sheepgate:autostart')) {
      sessionStorage.removeItem('sheepgate:autostart');
      doRestart();
    } else {
      showModePopup(false);
    }
  });
})();
</script>
</BaseLayout>
