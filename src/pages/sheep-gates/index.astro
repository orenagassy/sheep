        const emojiMap = { leg: '🍗', clover: '🍀', double: '2X' };
        state.rainbowGateBonuses.forEach((type, idx) => stampTestMark(gates, idx, emojiMap[type]));
      } else {
        if (state.hintGateIdx >= 0)    stampTestMark(gates, state.hintGateIdx, '🍗');
        if (state.hintCloverIdx >= 0)  stampTestMark(gates, state.hintCloverIdx, '🍀');
        if (state.hintDoubleScoreIdx >= 0)                       stampTestMark(gates, state.hintDoubleScoreIdx, '2X');
