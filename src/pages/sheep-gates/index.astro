      <g class="leg leg-bl"><rect x="49" y="42" width="6" height="13" rx="3"   fill="#c2b89a"/><rect x="49" y="51" width="6" height="5" rx="2" fill="#3a2e1e"/></g>
      <g class="leg leg-br"><rect x="55" y="42" width="5" height="13" rx="2.5" fill="#b4aa8c"/><rect x="55" y="51" width="5" height="5" rx="2" fill="#2e2418"/></g>
      <g class="leg leg-fl"><rect x="26" y="42" width="6" height="13" rx="3"   fill="#cac0a0"/><rect x="26" y="51" width="6" height="5" rx="2" fill="#3a2e1e"/></g>
      <g class="leg leg-fr"><rect x="33" y="42" width="5" height="13" rx="2.5" fill="#bcb294"/><rect x="33" y="51" width="5" height="5" rx="2" fill="#2e2418"/></g>
      <path d="M2,34 C2,16 26,16 26,34 Z" fill="#b71c1c"/>
      <path d="M14,16 C21,16 26,23 26,34 L21,34 C21,25 18,18 14,16 Z" fill="#8b0000"/>
      <path d="M13.5,16 L13.5,34" stroke="#ffd600" stroke-width="2" fill="none"/>
      <path d="M2,34 C0,42 5,44 13,43" stroke="#7b0000" stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <line x1="5"   y1="28" x2="4"   y2="41" stroke="#888" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="9"   y1="27" x2="8"   y2="39" stroke="#888" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="3.8" y1="33" x2="8.5" y2="32" stroke="#888" stroke-width="1.0" stroke-linecap="round"/>
      <circle cx="11"  cy="30"   r="2.2" fill="#1e1810"/>
      <circle cx="10.2" cy="29.2" r="0.6" fill="white"/>
    </svg>`;
    $('title-sheep').innerHTML = _sportSheepSVG;
    const _favLink = document.querySelector('link[rel="icon"]');
    if (_favLink) _favLink.href = "data:image/svg+xml," + encodeURIComponent(
      `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 70 58'>` +
      `<circle cx='38' cy='26' r='17' fill='%23eeeae0'/>` +
      `<circle cx='27' cy='21' r='12' fill='%23f3f1e8'/>` +
      `<circle cx='44' cy='19' r='12' fill='%23edeae2'/>` +
      `<circle cx='51' cy='27' r='10' fill='%23e9e6dc'/>` +
      `<circle cx='28' cy='33' r='10' fill='%23e9e6dc'/>` +
      `<ellipse cx='13' cy='33' rx='10' ry='9' fill='%23d5caaf'/>` +
      `<ellipse cx='6' cy='37' rx='5' ry='4' fill='%23c9bda0'/>` +
      `<path d='M2,34 C2,16 26,16 26,34 Z' fill='%23b71c1c'/>` +
      `<path d='M14,16 C21,16 26,23 26,34 L21,34 C21,25 18,18 14,16Z' fill='%238b0000'/>` +
      `<path d='M13.5,16 L13.5,34' stroke='%23ffd600' stroke-width='2' fill='none'/>` +
      `<circle cx='11' cy='30' r='2.5' fill='%231e1810'/>` +
      `</svg>`
    );
    document.getElementById('sheep-sport-bolt').setAttribute('display', 'block');
  }

  generateGrassBlades();
  generateStars();
  updateFieldAmbience(1);
  renderStats();
  statusLabel.textContent = 'Loading...';
  Promise.all([signInAnonymously(), loadConfig()]).then(async ([token]) => {
    firebaseToken = token;
    if (GROUP_MODE) {
      const valid = await checkGroupExpiry();
      if (!valid) {
        // Group expired — show mode popup so the user can still play normally.
        showModePopup(false);
        return;
      }
      document.getElementById('group-badge').style.display = 'inline';
      document.getElementById('mpc-leave-group').style.display = 'block';
    }
    await loadLeaderboard();
    if (sessionStorage.getItem('sheepgate:autostart')) {
      sessionStorage.removeItem('sheepgate:autostart');
      doRestart();
    } else {
      showModePopup(false);
    }
  });
})();
</script>
</BaseLayout>
