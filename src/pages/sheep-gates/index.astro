  async function createGroupInFirebase(id) {
    const now = Date.now();
    // Write meta and leaderboard in a single PUT to the group node — atomic, one request.
    const res = await fetch(authUrl(`${FIREBASE_DB_URL}/groups/${id}.json`), {
      method: 'PUT', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ meta: { created: now, lastActive: now }, normal: { scores: [] }, sport: { scores: [] } })
    });
    if (!res.ok) throw new Error('createGroup HTTP ' + res.status);
  }
  async function loadGroupLeaderboard() {
