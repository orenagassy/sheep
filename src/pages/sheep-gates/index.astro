  // ---- Particle effects --------------------------------------------------
  function spawnCrashParticles(gateEl) {
    const gr = gateEl.getBoundingClientRect(), fr = fieldEl.getBoundingClientRect();
    const cx = gr.left - fr.left + gr.width / 2;
    const cy = gr.top  - fr.top  + gr.height / 2;
    const colors = ['#9c7b44','#8b6f47','#7a5c35','#c4a060','#5d4a30'];
    for (let i = 0; i < 14; i++) {
      const p = document.createElement('div');
      p.className = 'crash-particle';
      const angle = (i / 14) * Math.PI * 2 + Math.random() * 0.4;
      const speed = 28 + Math.random() * 44;
      const w = 4 + Math.random() * 6, h = 2 + Math.random() * 4;
      p.style.cssText = 'width:' + w + 'px;height:' + h + 'px;background:' + colors[i % colors.length] + ';left:' + cx + 'px;top:' + cy + 'px;';
      p.style.setProperty('--dx', (Math.cos(angle) * speed) + 'px');
      p.style.setProperty('--dy', (Math.sin(angle) * speed) + 'px');
      fieldEl.appendChild(p);
      setTimeout(() => p.remove(), 600);
    }
  }
  function spawnConfetti() {
    const colors = ['#ff6b6b','#4ecdc4','#45b7d1','#f9ca24','#a29bfe','#fd79a8','#6ab04c'];
    for (let i = 0; i < 22; i++) {
      const p = document.createElement('div');
      p.className = 'confetti-piece';
      const size = 6 + Math.random() * 6;
      const dur  = (0.7 + Math.random() * 0.6) + 's';
      const rot  = (360 + Math.random() * 360) + 'deg';
      p.style.cssText = 'width:' + size + 'px;height:' + size + 'px;background:' + colors[i % colors.length] + ';left:' + (15 + Math.random() * 70) + '%;top:2px;';
      p.style.setProperty('--dur', dur);
      p.style.setProperty('--rot', rot);
      p.style.animationDelay = (Math.random() * 0.25) + 's';
      fieldEl.appendChild(p);
      setTimeout(() => p.remove(), 1600);
    }
  }
  function spawnFloatingScore(gateEl, label) {
