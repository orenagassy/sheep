  // ---- Gate building ------------------------------------------------------
  function pickBlockedIndices(count, rng) {
    rng = rng || Math.random;
    const indices = [], pool = Array.from({ length: GATES_PER_ROUND }, (_, i) => i);
    for (let n = 0; n < count; n++) {
      const idx = Math.floor(rng() * pool.length);
      indices.push(pool[idx]); pool.splice(idx, 1);
    }
    return indices;
  }
  function buildGateSet(yOffset) {
    const set = document.createElement('div');
    set.className = 'gate-set';
    set.style.cssText = 'position:absolute;left:16px;right:16px;top:' + yOffset + 'px;display:grid;grid-template-columns:repeat(7,1fr);gap:6px;height:95px;';
    for (let i = 0; i < GATES_PER_ROUND; i++) {
      const wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative;height:95px;perspective:400px;';
      const hinge = document.createElement('div');
      hinge.style.cssText = 'position:absolute;top:0;bottom:0;left:0;width:4px;background:linear-gradient(to right,#3a2a14,#5d4a30);border-radius:2px;z-index:0;box-shadow:2px 0 4px rgba(0,0,0,0.3);';
      wrap.appendChild(hinge);
      const gate = document.createElement('button');
      gate.className = 'gate';
      gate.dataset.idx = i;
      const _rc = state.isRainbowRound ? RAINBOW_GATE_COLORS[i] : null;
      gate.style.cssText = 'position:absolute;top:0;left:4px;right:0;bottom:0;background:' + (_rc || 'repeating-linear-gradient(90deg,#9c7b44 0px,#8b6f47 4px,#7a5c35 7px,#8b6f47 10px,#9a7840 14px)') + ';border:2px solid ' + (_rc || '#5d4a30') + ';border-left:none;border-radius:0 4px 4px 0;padding:0;cursor:pointer;transform-origin:left center;transform:rotateY(0deg);transition:transform 0.15s,background 0.4s,border-color 0.4s;display:flex;align-items:center;justify-content:center;overflow:hidden;will-change:transform;touch-action:manipulation;box-shadow:inset 0 0 12px rgba(0,0,0,0.15),2px 0 4px rgba(0,0,0,0.2);';
      const planks = document.createElement('div');
      planks.className = 'planks';
      planks.style.cssText = 'width:82%;height:100%;display:flex;flex-direction:column;justify-content:space-around;padding:5px 0;transition:opacity 0.3s;';
      for (let p = 0; p < 3; p++) {
        const plank = document.createElement('div');
        plank.className = 'gate-plank';
        if (_rc) plank.style.background = 'rgba(255,255,255,0.20)';
        planks.appendChild(plank);
      }
      gate.appendChild(planks);
      gate.onmouseover = () => { if (!gate.disabled) gate.style.transform = 'translateY(-3px)'; };
      gate.onmouseout  = () => { if (!gate.disabled) gate.style.transform = 'translateY(0)'; };
      gate.onclick = () => pickGate(i);
      gate.setAttribute('aria-label', 'Gate ' + (i + 1));
      wrap.appendChild(gate); set.appendChild(wrap);
    }
    return set;
  }

  // ---- HUD ----------------------------------------------------------------
  function stampTestMark(gates, idx, emoji) {
    const m = document.createElement('div');
    m.className = emoji === '🐺' ? 'test-mark test-mark-wolf' : 'test-mark';
    m.textContent = emoji;
    if (emoji === '2X') { m.style.color = '#ffd700'; m.style.fontWeight = '900'; }
    gates[idx].parentNode.appendChild(m);
  }
  function newRound() {
    state.isRainbowRound = false;
    const rainbowChance = _cfg._k ?? 0.05;
    if (Math.random() < rainbowChance) {
      state.isRainbowRound = true;
      state.rainbowRoundUsed = true;
    }

    if (state.isRainbowRound) {
      state.blockedGates = [];
      state.hintGateIdx = -1; state.hintCloverIdx = -1; state.hintDoubleScoreIdx = -1;
      state.rainbowGateBonuses = Array.from({length: GATES_PER_ROUND},
        () => RAINBOW_BONUS_TYPES[Math.floor(Math.random() * RAINBOW_BONUS_TYPES.length)]);
      rainbowSkyEl.style.opacity = '1';
    } else {
      state.blockedGates = pickBlockedIndices(getBlockedCount());
      rainbowSkyEl.style.opacity = '0';
      const openGates = Array.from({length: GATES_PER_ROUND}, (_, i) => i)
        .filter(i => !state.blockedGates.includes(i));
      const legChance = _cfg._h ?? 1/10;
      const clovChance = _cfg._i ?? 1/10;
      const dblChance  = _cfg._j ?? 1/10;
      // Each open gate rolls independently — 10% per gate per bonus type
      const legPool  = openGates.filter(() => Math.random() < legChance);
      state.hintGateIdx = legPool.length  ? legPool[Math.floor(Math.random()  * legPool.length)]  : -1;
      const openForClover = openGates.filter(i => i !== state.hintGateIdx);
      const clovPool = openForClover.filter(() => Math.random() < clovChance);
      state.hintCloverIdx = clovPool.length ? clovPool[Math.floor(Math.random() * clovPool.length)] : -1;
      const openForDouble = openForClover.filter(i => i !== state.hintCloverIdx);
      const dblPool  = openForDouble.filter(() => Math.random() < dblChance);
      state.hintDoubleScoreIdx = dblPool.length ? dblPool[Math.floor(Math.random()  * dblPool.length)]  : -1;
    }
