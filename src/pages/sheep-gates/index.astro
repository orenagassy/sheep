  async function checkGroupExpiry() {
    try {
      const res = await fetch(`${FIREBASE_DB_URL}/groups/${GROUP_ID}/meta.json`);
      if (!res.ok) { showGroupExpiredMessage(); return false; }
      const meta = await res.json();
      if (!meta) { showGroupExpiredMessage(); return false; }
      if (Date.now() - meta.lastActive > GROUP_TTL_MS) {
        fetch(authUrl(`${FIREBASE_DB_URL}/groups/${GROUP_ID}.json`), { method: 'DELETE' }).catch(() => {});
        showGroupExpiredMessage(); return false;
      }
      // Touch lastActive — fire-and-forget, non-critical
      fetch(authUrl(`${FIREBASE_DB_URL}/groups/${GROUP_ID}/meta.json`), {
        method: 'PATCH', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ lastActive: Date.now() })
      }).catch(() => {});
      return true;
    } catch (_) { return true; }
  }
