  // ---- Group / Play-with-Friends ------------------------------------------
  function generateGroupId() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    return Array.from({length: 7}, () => chars[Math.floor(Math.random() * chars.length)]).join('');
  }
