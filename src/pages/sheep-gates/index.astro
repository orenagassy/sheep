  // ---- Web Audio ---------------------------------------------------------
  let _audioCtx = null;
  let MUTED = localStorage.getItem(MUTE_KEY) === '1';
  function _audio() {
    if (MUTED) return null;
    try {
      if (!_audioCtx || _audioCtx.state === 'closed')
        _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (_audioCtx.state === 'suspended') _audioCtx.resume();
      return _audioCtx;
    } catch (_) { return null; }
  }
  function _tone(freq, type, vol, start, dur) {
    const ctx = _audio(); if (!ctx) return;
    const t = ctx.currentTime + start;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = type; o.frequency.value = freq;
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(vol, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.001, t + dur);
    o.start(t); o.stop(t + dur);
  }
  function playGateOpen() {
    _tone(523, 'triangle', 0.15, 0,    0.3);
    _tone(659, 'triangle', 0.12, 0.09, 0.3);
    _tone(784, 'triangle', 0.10, 0.18, 0.4);
  }
  function playGateCrash() {
    const ctx = _audio(); if (!ctx) return;
    const t = ctx.currentTime;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = 'sawtooth';
    o.frequency.setValueAtTime(200, t); o.frequency.exponentialRampToValueAtTime(40, t + 0.25);
    g.gain.setValueAtTime(0.25, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
    o.start(t); o.stop(t + 0.3);
    const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * 0.18), ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
    const src = ctx.createBufferSource(), f = ctx.createBiquadFilter(), ng = ctx.createGain();
    src.buffer = buf; f.type = 'lowpass'; f.frequency.value = 350; ng.gain.value = 0.35;
    src.connect(f); f.connect(ng); ng.connect(ctx.destination);
    src.start(t);
  }
  function playSheepStep() {
    const ctx = _audio(); if (!ctx) return;
    const t = ctx.currentTime;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = 'sine';
    o.frequency.setValueAtTime(85, t); o.frequency.exponentialRampToValueAtTime(50, t + 0.04);
    g.gain.setValueAtTime(0.07, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.07);
    o.start(t); o.stop(t + 0.07);
    spawnHoofPrint();
  }
  function playWolfGrowl() {
    const ctx = _audio(); if (!ctx) return;
    const t = ctx.currentTime;
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = 'sawtooth';
    o.frequency.setValueAtTime(95,  t);
    o.frequency.setValueAtTime(115, t + 0.07);
    o.frequency.setValueAtTime(80,  t + 0.15);
    o.frequency.setValueAtTime(108, t + 0.23);
    o.frequency.exponentialRampToValueAtTime(70, t + 0.5);
    g.gain.setValueAtTime(0.001, t);
    g.gain.linearRampToValueAtTime(0.20,  t + 0.05);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.58);
    o.start(t); o.stop(t + 0.6);
  }
  function playWolfChomp() {
    const ctx = _audio(); if (!ctx) return;
    const t = ctx.currentTime;
    const bufLen = Math.floor(ctx.sampleRate * 0.11);
    const buf = ctx.createBuffer(1, bufLen, ctx.sampleRate);
    const d   = buf.getChannelData(0);
    for (let i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufLen, 1.4);
    const src = ctx.createBufferSource(), filt = ctx.createBiquadFilter(), ng = ctx.createGain();
    src.buffer = buf;
    filt.type = 'bandpass'; filt.frequency.value = 900; filt.Q.value = 1.2;
    ng.gain.value = 0.55;
    src.connect(filt); filt.connect(ng); ng.connect(ctx.destination);
    src.start(t);
    _tone(280, 'triangle', 0.10, 0.06, 0.11);
    _tone(370, 'triangle', 0.08, 0.15, 0.11);
    _tone(460, 'triangle', 0.06, 0.24, 0.13);
