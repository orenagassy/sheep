---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/sheep-gates.css';
const firebaseApiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "@id": "https://sheeps.online/sheep-gates/#game",
      "name": "Sheep Gates",
      "url": "https://sheeps.online/sheep-gates/",
      "description": "Pick the open gate, dodge the wolves, and survive as long as you can. A fast-paced casual browser game for kids and adults. Features a global leaderboard, friend groups, bonus power-ups, and escalating difficulty.",
      "genre": ["Casual", "Arcade", "Action", "Kids"],
      "playMode": "SinglePlayer",
      "applicationCategory": "Game",
      "operatingSystem": "Any",
      "gamePlatform": "Web Browser",
      "isAccessibleForFree": true,
      "inLanguage": "en",
      "image": "https://sheeps.online/og-image.svg",
      "publisher": {
        "@type": "Organization",
        "@id": "https://sheeps.online/#organization",
        "name": "Sheeps.online",
        "url": "https://sheeps.online/"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 5
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Free Games", "item": "https://sheeps.online/" },
        { "@type": "ListItem", "position": 2, "name": "Sheep Gates", "item": "https://sheeps.online/sheep-gates/" }
      ]
    }
  ]
});
---
<BaseLayout
  title="Sheep Gates — Free Online Casual Game | Sheeps.online"
  description="Play Sheep Gates free in your browser! Pick the open gate, dodge the wolves, and survive as long as you can. Casual arcade game for kids and adults. No download."
>
  <Fragment slot="head">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐑</text></svg>">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
<div class="app">
  <h1><span id="title-sheep">🐑</span> Sheep Gates</h1>
  <p class="tagline">Bet on the open gate. Survive as long as you can.</p>


  <div class="ad-wrap ad-wrap--top">
    <!-- Ad unit loads here after AdSense approval -->
  </div>

  <div id="game-container">

    <div class="topbar">
      <div class="topbar-left">
        <span id="group-badge">👥 Group Mode</span>
        <div>
          <div class="hud-title" id="round-label">Gate 1 · Level 1</div>
          <div class="hud-subtitle" id="status-label">Pick the open gate</div>
        </div>
      </div>
      <div class="stat-group">
        <div class="stat">
          <div class="stat-label">Score</div>
          <div class="stat-value" id="score">0</div>
        </div>
        <div class="stat">
          <div class="stat-label">Your best</div>
          <div class="stat-value" id="personal-best-display">—</div>
        </div>
      </div>
    </div>

    <div class="level-bar-wrap">
      <div class="level-bar-text">
        <span id="level-label">Level 1 · 6 of 7 open</span>
        <span id="level-progress-text">0 / 7</span>
      </div>
      <div class="level-bar-track">
        <div class="level-bar-fill" id="level-progress-bar"></div>
      </div>
      <div id="streak-row"></div>
    </div>

    <div id="field">
      <div id="chicken-leg-hud" title="You have a chicken leg! The wolf will eat it instead of you.">🍗</div>
      <div id="lucky-clover-hud" title="Lucky Clover! Click to scare away one wolf.">🍀</div>
      <div id="double-score-hud" title="2X Score! Your next rounds count double.">2X</div>
      <div id="sport-timer"><div id="sport-timer-bar"></div></div>
      <div id="field-overlay"></div>
      <div id="stars"></div>
      <div id="rainbow-sky"><div class="rainbow-arc"></div></div>
      <div id="clouds">
        <div class="cloud c1"></div>
        <div class="cloud c2"></div>
        <div class="cloud c3"></div>
      </div>
      <div id="world"></div>
      <div id="grass-blades"></div>
      <div id="sheep" aria-hidden="true">
        <span id="sheep-dead"></span>
        <svg id="sheep-svg" viewBox="0 0 70 58" width="70" height="58"
             xmlns="http://www.w3.org/2000/svg" style="overflow:visible;display:block;">
          <circle cx="38" cy="26" r="17" fill="#eeeae0"/>
          <circle cx="27" cy="21" r="12" fill="#f3f1e8"/>
          <circle cx="44" cy="19" r="12" fill="#edeae2"/>
          <circle cx="51" cy="27" r="10" fill="#e9e6dc"/>
          <circle cx="28" cy="33" r="10" fill="#e9e6dc"/>
          <circle cx="41" cy="34" r="8"  fill="#e6e3d9"/>
          <ellipse cx="13" cy="33" rx="10" ry="9" fill="#d5caaf"/>
          <ellipse cx="6" cy="37" rx="5" ry="4" fill="#c9bda0"/>
          <circle cx="4.5" cy="38.5" r="1.1" fill="#9c8c74"/>
          <circle cx="7.5" cy="38.5" r="1.1" fill="#9c8c74"/>
          <circle cx="11" cy="30" r="2.2" fill="#1e1810"/>
          <circle cx="10.2" cy="29.2" r="0.6" fill="white"/>
          <ellipse cx="18" cy="25" rx="3.5" ry="5.5" fill="#d5caaf" transform="rotate(15,18,25)"/>
          <ellipse cx="18" cy="25" rx="2"   ry="3.5" fill="#edc0b8" transform="rotate(15,18,25)"/>
          <g class="leg leg-bl">
            <rect x="49" y="42" width="6" height="13" rx="3"   fill="#c2b89a"/>
            <rect x="49" y="51" width="6" height="5"  rx="2"   fill="#3a2e1e"/>
          </g>
          <g class="leg leg-br">
            <rect x="55" y="42" width="5" height="13" rx="2.5" fill="#b4aa8c"/>
            <rect x="55" y="51" width="5" height="5"  rx="2"   fill="#2e2418"/>
          </g>
          <g class="leg leg-fl">
            <rect x="26" y="42" width="6" height="13" rx="3"   fill="#cac0a0"/>
            <rect x="26" y="51" width="6" height="5"  rx="2"   fill="#3a2e1e"/>
          </g>
          <g class="leg leg-fr">
            <rect x="33" y="42" width="5" height="13" rx="2.5" fill="#bcb294"/>
            <rect x="33" y="51" width="5" height="5"  rx="2"   fill="#2e2418"/>
          </g>
          <!-- sport bolt badge on wool (shown only in sport mode) -->
          <g id="sheep-sport-bolt" display="none">
            <circle cx="45" cy="23" r="7" fill="#ffb300" opacity="0.92"/>
            <text x="45" y="23" font-size="11" text-anchor="middle" dominant-baseline="middle" fill="#3d1a00">⚡</text>
          </g>
          <!-- devious face (shown only when feeding the wolf) -->
          <g id="sheep-devious-face" display="none">
            <path d="M7.5 27.5 Q10.5 24 14 27" fill="none" stroke="#1e1810" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="12" cy="30.8" r="0.65" fill="#e53935"/>
            <path d="M3.5 39 Q6 41.8 10.5 38.5" fill="none" stroke="#6d4c41" stroke-width="1.4" stroke-linecap="round"/>
            <polygon points="6,39.5 8,39.5 7,42" fill="white"/>
          </g>
        </svg>
      </div>
      <div id="grass-front"></div>
      <div id="message"></div>
      <div id="level-up-banner">Level up!</div>
    </div>

    <div id="hiscore-entry" style="display: none;">
      <div class="entry-title">🏅 New world best!</div>
      <div class="entry-subtitle">Enter your name (up to 10 characters)</div>
      <div class="entry-row">
        <input id="hiscore-name" type="text" maxlength="10" autocomplete="off"
               style="width: 160px; text-align: center; text-transform: uppercase; font-size: 16px; letter-spacing: 2px; font-weight: 500;" />
        <button id="hiscore-save" style="font-weight: 500;">Save</button>
      </div>
    </div>

    <div class="action-bar">
      <button id="restart-btn" style="display: none;">Try again</button>
    </div>

    <details>
      <summary>How to play &amp; what even is this</summary>
      <p>You are a sheep. There are 7 gates. One of them will get you eaten. Your job: don't get eaten. Simple! Except it's really not, because with every level another gate locks shut — until you're basically playing Russian roulette with a wolf on the other side. Level 1 is chill (6 of 7 open). Level 7 is pure chaos (1 of 7 open). Good luck.</p>
      <p>Sometimes the gates hide surprises. A 🍗 chicken leg means the wolf eats <em>that</em> instead of you — congratulations, you sacrificed a drumstick for science. A 🍀 lucky clover straight-up scares the wolf away (wolves hate clovers, apparently). A 2X means your next gates count double, so try not to immediately walk into a wolf.</p>
      <p><strong>Normal mode:</strong> Take your time. Think it through. Panic anyway.<br/>
      <strong>Sport mode ⚡:</strong> You have a timer. You will not be ready. Pick faster.</p>
      <p><strong>Bragging rights:</strong> Your score goes on a live global leaderboard so the whole internet can see how long your sheep survived. Hit Play with Friends, share the link, and drag your friends into the suffering — group mode keeps a private Top 5 just for your crew.</p>
      <p>Free browser game. No download, no sign-up, no excuses. Works on any device — desktop, phone, tablet, that ancient laptop in the corner. Kids love it. Adults get unreasonably competitive about it.</p>
    </details>
  </div>

</div>

<div id="info-overlay"></div>
<div id="info-drawer">
  <div id="info-drawer-header">
    <span>Leaderboard &amp; Stats</span>
    <button id="info-close">✕</button>
  </div>

  <div style="display:flex;gap:8px;margin-bottom:16px">
    <div style="flex:1;display:flex;justify-content:space-between;align-items:center;background:var(--bg-soft);border-radius:8px;padding:8px 12px">
      <span style="font-size:13px;font-weight:500">👁 God Mode</span>
      <button id="god-mode-toggle" style="font-size:12px;font-weight:600;min-width:44px"></button>
    </div>
    <div style="flex:1;display:flex;justify-content:space-between;align-items:center;background:var(--bg-soft);border-radius:8px;padding:8px 12px">
      <span style="font-size:13px;font-weight:500">🔇 Mute</span>
      <button id="mute-toggle" style="font-size:12px;font-weight:600;min-width:44px"></button>
    </div>
  </div>

  <div id="leaderboard">
    <div class="leaderboard-title">
      <span id="leaderboard-title">Top 5 of all time</span>
      <span class="sync-indicator" id="sync-indicator"></span>
    </div>
    <div id="leaderboard-list"></div>
  </div>
  <div id="stats-panel">
    <div class="stats-title">Your all-time stats</div>
    <div class="stats-grid">
      <div>
        <div class="stat-item-label">Gates cleared</div>
        <div class="stat-item-value" id="stat-gates">0</div>
      </div>
      <div>
        <div class="stat-item-label">Games played</div>
        <div class="stat-item-value" id="stat-games">0</div>
      </div>
      <div>
        <div class="stat-item-label">Average score</div>
        <div class="stat-item-value" id="stat-avg">—</div>
      </div>
      <div>
        <div class="stat-item-label">Best level</div>
        <div class="stat-item-value" id="stat-level">1</div>
      </div>
      <div>
        <div class="stat-item-label">Lives saved 🍗</div>
        <div class="stat-item-value" id="stat-hints-used">0</div>
      </div>
      <div>
        <div class="stat-item-label">Drumsticks found</div>
        <div class="stat-item-value" id="stat-hints-found">0</div>
      </div>
      <div>
        <div class="stat-item-label">Best streak</div>
        <div class="stat-item-value" id="stat-streak">0</div>
      </div>
      <div>
        <div class="stat-item-label">Personal best</div>
        <div class="stat-item-value" id="stat-personal-best">—</div>
      </div>
    </div>
  </div>

  <div class="ad-wrap ad-wrap--drawer">
    <!-- Ad unit loads here after AdSense approval -->
  </div>
  <div id="drawer-credits">⚡🧠🐢</div>
</div>

<div id="mode-overlay">
  <div id="mode-popup">
    <div id="mode-popup-result" style="display:none">
      <div id="mode-popup-score-val"></div>
      <div id="mode-popup-score-sub"></div>
    </div>
    <div id="mode-popup-topbar">
      <div id="mode-popup-title">🐑 Sheep Gates</div>
      <button id="popup-stats-btn" title="Leaderboard &amp; stats">☰</button>
    </div>
    <div id="mode-popup-sub">Choose your mode</div>
    <div id="mode-btn-wrap">
      <button id="mpc-normal" class="mode-btn">
        <span class="mode-btn-icon">🐑</span>Normal
      </button>
      <button id="mpc-sport" class="mode-btn">
        <span class="mode-btn-icon">⚡</span>Sport
      </button>
    </div>
    <button id="mpc-friends" class="mpc-friends-btn">
      <span class="mpc-icon">👥</span>
      <span>
        <span class="mpc-name">Play with Friends</span>
        <span class="mpc-desc">Share a link · Group Top 5</span>
      </span>
    </button>
    <button id="mpc-leave-group" class="mpc-leave-group-btn" style="display:none">
      ✕ Stop Group Mode
    </button>
    <a href="/" class="more-games-link">🎮 More free games →</a>
  </div>
</div>

<div id="friends-overlay">
  <div id="friends-popup">
    <div id="friends-popup-title">👥 Play with Friends</div>
    <p id="friends-popup-desc">Share this link — everyone on it competes for your group's Top 5.</p>
    <div id="friends-link-box">
      <input id="friends-link-input" type="text" readonly />
    </div>
    <div id="friends-share-row">
      <button id="friends-share-twitter" class="friends-share-btn share-twitter" title="Share on X / Twitter">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.738l7.737-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </button>
      <button id="friends-share-ig" class="friends-share-btn share-ig" title="Share on Instagram">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </button>
      <button id="friends-share-tiktok" class="friends-share-btn share-tiktok" title="Share on TikTok">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.67a8.27 8.27 0 004.84 1.56V6.78a4.85 4.85 0 01-1.07-.09z"/></svg>
      </button>
      <button id="friends-share-copy" class="friends-share-btn share-copy" title="Copy link">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
      </button>
    </div>
    <button id="friends-play-btn">▶ Play in Group Mode</button>
    <button id="friends-close-btn">✕ Close</button>
  </div>
</div>

<button id="stats-btn" title="Leaderboard &amp; stats">☰</button>

<script define:vars={{ firebaseApiKey }}> window.__FB_KEY__ = firebaseApiKey; </script>
<script is:inline>
(function() {
  const FIREBASE_DB_URL  = 'https://sheep-game-4852f-default-rtdb.firebaseio.com/sheep-gates';
  const FIREBASE_API_KEY = window.__FB_KEY__;
  let firebaseToken = null;
  const TEST_MODE  = new URLSearchParams(location.search).has('test')
                  || localStorage.getItem('sheepgate:god-mode') === '1';
  const SPORT_MODE = new URLSearchParams(location.search).has('sport');
  // Save group ID to sessionStorage when entering via group URL, and read it back
  // as a fallback so group mode survives any URL change within the same tab.
  const _urlGroupId = new URLSearchParams(location.search).get('g') ?? null;
  if (_urlGroupId) {
    sessionStorage.setItem('sheepgate:active-group', _urlGroupId);
  } else {
    // Plain URL navigation means the user intentionally left group mode — clear the stored ID.
    sessionStorage.removeItem('sheepgate:active-group');
  }
  const GROUP_ID   = _urlGroupId ?? null;
  const GROUP_MODE = !!GROUP_ID;
  const GROUP_STORAGE_KEY = 'sheepgate:group';
  const GROUP_TTL_MS = 864_000_000; // 10 days

  const GATES_PER_ROUND    = 7;
  const ROUNDS_PER_LEVEL   = 7;
  const FIELD_HEIGHT        = 320;
  const MAX_LEADERBOARD     = 5;
  // rainbowRoundChance loaded from Firebase config (_cfg._k)
  const RAINBOW_GATE_COLORS  = ['#e74c3c','#e67e22','#f1c40f','#2ecc71','#3498db','#9b59b6','#e91e8c'];
  const RAINBOW_BONUS_TYPES  = ['leg', 'clover', 'double'];

  // Game mechanics loaded from Firebase at boot — edit at firebase.google.com → your project → Realtime Database → /sheep-gates/config
  let _cfg = null;
  async function loadConfig() {
    try {
      const res = await fetch(`${FIREBASE_DB_URL}/config.json`);
      if (!res.ok) throw new Error(res.status);
      const d = await res.json();
      _cfg = Object.freeze({
        _a: d.sportTimerMs        ?? 8000,
        _b: d.hintChance          ?? 0.02,
        _c: d.sportTier1Ms        ?? 1000,
        _d: d.sportTier2Ms        ?? 2500,
        _e: d.sportTier3Ms        ?? 4000,
        _f: d.sportTier1Bonus     ?? 5,
        _g: d.sportTier2Bonus     ?? 3,
        _h: d.chickenLegChance    ?? 0.1,
        _i: d.cloverChance        ?? 0.1,
        _j: d.doubleScoreChance   ?? 0.1,
        _k: d.rainbowRoundChance  ?? 0.05,
        _l: d.doubleScoreDuration ?? 3,
        _m: d.basePoints          ?? 8,
        _n: d.basePointsPerLevel  ?? 2,
      });
    } catch(e) {
      console.warn('Config unavailable, using offline defaults');
      _cfg = Object.freeze({ _a:8000, _b:0.02, _c:1000, _d:2500, _e:4000, _f:5, _g:3, _h:0.1, _i:0.1, _j:0.1, _k:0.05, _l:3, _m:8, _n:2 });
    }
  }
  const GOD_MODE_KEY        = 'sheepgate:god-mode';
  const MUTE_KEY            = 'sheepgate:mute';
  const LOCAL_FALLBACK_KEY  = 'sheepgate:local-leaderboard';
  const SPORT_LB_KEY        = 'sheepgate:sport-leaderboard';
  const STATS_KEY           = 'sheepgate:stats';
  const PERSONAL_BEST_KEY   = 'sheepgate:personal-best';
  const ACHIEVEMENTS_KEY    = 'sheepgate:achievements';
  const SHEEP_TRANSITION = SPORT_MODE
    ? 'left 0.175s cubic-bezier(0.45, 0.05, 0.55, 0.95), bottom 0.175s cubic-bezier(0.45, 0.05, 0.55, 0.95), transform 0.075s, opacity 0.075s'
    : 'left 0.7s cubic-bezier(0.45, 0.05, 0.55, 0.95), bottom 0.7s cubic-bezier(0.45, 0.05, 0.55, 0.95), transform 0.3s, opacity 0.3s';
  const WORLD_TRANSITION = SPORT_MODE
    ? 'transform 0.4s cubic-bezier(0.4, 0.0, 0.2, 1)'
    : 'transform 1.6s cubic-bezier(0.4, 0.0, 0.2, 1)';

  // ---- Stats persistence -------------------------------------------------
  function loadStats() {
    try {
      return Object.assign(
        { gatesCleared:0, gamesPlayed:0, totalScore:0, bestLevel:1, hintsUsed:0, hintsFound:0, streakBest:0 },
        JSON.parse(localStorage.getItem(STATS_KEY))
      );
    } catch(_) {
      return { gatesCleared:0, gamesPlayed:0, totalScore:0, bestLevel:1, hintsUsed:0, hintsFound:0, streakBest:0 };
    }
  }
  function saveStats() {
    try { localStorage.setItem(STATS_KEY, JSON.stringify(stats)); } catch(_) {}
  }
  let stats = loadStats();

  let personalBest = parseInt(localStorage.getItem(PERSONAL_BEST_KEY)) || 0;

  // ---- Achievements -------------------------------------------------------
  const ACHIEVEMENTS = [
    { id: 'gate1',    icon: '🚪', label: 'First Step',       desc: 'Clear your first gate',         check: (s, st) => st.gatesCleared >= 1 },
    { id: 'level2',   icon: '📈', label: 'Leveling Up',      desc: 'Reach Level 2',                 check: (s, st) => st.bestLevel >= 2 },
    { id: 'level3',   icon: '🏅', label: 'Getting Serious',  desc: 'Reach Level 3',                 check: (s, st) => st.bestLevel >= 3 },
