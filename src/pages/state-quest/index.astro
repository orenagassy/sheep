  // ── DOM references ─────────────────────────────────────────────────────────
  const scoreEl    = document.getElementById('score-display');
  const bestEl     = document.getElementById('best-display');
  const roundValEl = document.getElementById('round-display-val');
  const hudSub     = document.getElementById('hud-subtitle');
  const signWrap   = document.getElementById('sign-wrap');
  const stateSign  = document.getElementById('state-sign');
  const timerLbl   = document.getElementById('timer-label');
  const timerBar   = document.getElementById('timer-bar');
  const timerWrap  = document.getElementById('timer-bar-wrap');
  const roundPips  = document.getElementById('round-display');
  const mapWrap    = document.getElementById('map-wrap');
  const mapCont    = document.getElementById('map-svg-container');
  const sheep      = document.getElementById('map-sheep');
  const fbToast    = document.getElementById('feedback-toast');
  const corrLabel  = document.getElementById('state-correct-label');
  const resultOv   = document.getElementById('result-overlay');
  const resultBig  = document.getElementById('result-score-big');
  const resultLbl  = document.getElementById('result-label');
  const resultCorr = document.getElementById('result-correct');
  const resultGrd  = document.getElementById('result-grade');
  const resultEmo  = document.getElementById('result-emoji');
  const modePopup  = document.getElementById('mode-popup');
  const mpcNormal  = document.getElementById('mpc-normal');
  const mpcSport   = document.getElementById('mpc-sport');
  const mpcTitle   = document.getElementById('mode-popup-title');
  const mpcSub     = document.getElementById('mode-popup-sub');
  const mpcScoreWrap = document.getElementById('mode-popup-score');
  const mpcScoreVal  = document.getElementById('mode-popup-score-val');
  const mpcScoreSub  = document.getElementById('mode-popup-score-sub');
  const mpcNameRow = document.getElementById('mpc-name-row');
  const mpcNameIn  = document.getElementById('mpc-name');
  const mpcSave    = document.getElementById('mpc-save');
  const groupBadge = document.getElementById('group-badge');
  const resetZoom  = document.getElementById('reset-zoom');
  const statsBtn   = document.getElementById('stats-btn');

  // ── Init map ───────────────────────────────────────────────────────────────
  mapCont.innerHTML = MAP_SVG;

  // Center sheep
  const mRect = mapWrap.getBoundingClientRect();
  sheepX = mapWrap.offsetWidth / 2;
  sheepY = mapWrap.offsetHeight / 2;
  sheep.style.left = sheepX + 'px';
  sheep.style.top  = sheepY + 'px';

  // ── Zoom / pan helpers ────────────────────────────────────────────────────
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  function applyTransform() {
    mapCont.style.transform = `scale(${zoom}) translate(${panX}px, ${panY}px)`;
  }

  function resetView() {
    zoom = 1; panX = 0; panY = 0;
    applyTransform();
  }

  // Convert viewport coords (relative to mapWrap) → SVG coords
  function toSvgCoords(vx, vy) {
    // mapCont is centered via flex; its visual origin after scale/translate:
    // effective origin = (wrapW/2 - svgW*zoom/2) + panX*zoom + mapCont.offsetLeft
    const wrapW = mapWrap.offsetWidth;
    const wrapH = mapWrap.offsetHeight;
    const svgEl = mapCont.querySelector('svg');
    if (!svgEl) return [0, 0];
    const svgNatW = 960;
    const svgNatH = 600;
    // rendered SVG size (before zoom)
    const rendW = Math.min(wrapW, wrapW); // 100% of container width
    const rendH = Math.min(wrapH, wrapH);
    // SVG scales to fit container (preserveAspectRatio xMidYMid meet by default)
    const scaleRatio = Math.min(rendW / svgNatW, rendH / svgNatH);
    const displayW = svgNatW * scaleRatio;
    const displayH = svgNatH * scaleRatio;
    // SVG origin within mapCont (centered)
    const svgOriginX = (wrapW - displayW) / 2;
    const svgOriginY = (wrapH - displayH) / 2;
    // Account for zoom/pan transform on mapCont (transform-origin: center center)
    const tcX = wrapW / 2;
    const tcY = wrapH / 2;
    const transformedX = (vx - tcX) / zoom + tcX - panX;
    const transformedY = (vy - tcY) / zoom + tcY - panY;
    // Convert to SVG coordinate space
    const sx = (transformedX - svgOriginX) / scaleRatio;
    const sy = (transformedY - svgOriginY) / scaleRatio;
    return [sx, sy];
  }

  resetZoom.addEventListener('click', e => { e.stopPropagation(); resetView(); });

  // Mouse wheel zoom
  mapWrap.addEventListener('wheel', e => {
    e.preventDefault();
    const factor = e.deltaY > 0 ? 0.85 : 1.18;
    const prevZoom = zoom;
    zoom = clamp(zoom * factor, 1, 6);
    if (zoom !== prevZoom) applyTransform();
  }, { passive: false });

  // Drag to pan
  mapWrap.addEventListener('mousedown', e => {
    if (e.button !== 0) return;
    dragging = true;
    dragLast = { x: e.clientX, y: e.clientY };
    mapWrap.style.cursor = 'grabbing';
  });
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    const dx = (e.clientX - dragLast.x) / zoom;
    const dy = (e.clientY - dragLast.y) / zoom;
    dragLast = { x: e.clientX, y: e.clientY };
    const wrapW = mapWrap.offsetWidth;
    const wrapH = mapWrap.offsetHeight;
    const maxPan = ((zoom - 1) / zoom) * (wrapW / 2) + 40;
    const maxPanY = ((zoom - 1) / zoom) * (wrapH / 2) + 40;
    panX = clamp(panX + dx, -maxPan, maxPan);
    panY = clamp(panY + dy, -maxPanY, maxPanY);
    applyTransform();
  });
  window.addEventListener('mouseup', () => {
    dragging = false;
    mapWrap.style.cursor = 'crosshair';
  });

  // Touch: pinch-to-zoom + drag
  mapWrap.addEventListener('touchstart', e => {
    if (e.touches.length === 2) {
      e.preventDefault();
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      pinchDist0 = Math.hypot(dx, dy);
      pinchZoom0 = zoom;
      pinchPan0 = { x: panX, y: panY };
    } else if (e.touches.length === 1) {
      dragLast = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: false });

  mapWrap.addEventListener('touchmove', e => {
    e.preventDefault();
    if (e.touches.length === 2 && pinchDist0 !== null) {
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      const dist = Math.hypot(dx, dy);
      zoom = clamp(pinchZoom0 * (dist / pinchDist0), 1, 6);
      applyTransform();
    } else if (e.touches.length === 1 && dragLast) {
      const dx = (e.touches[0].clientX - dragLast.x) / zoom;
      const dy = (e.touches[0].clientY - dragLast.y) / zoom;
      dragLast = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      const wrapW = mapWrap.offsetWidth;
      const wrapH = mapWrap.offsetHeight;
      const maxPan = ((zoom - 1) / zoom) * (wrapW / 2) + 40;
      const maxPanY = ((zoom - 1) / zoom) * (wrapH / 2) + 40;
      panX = clamp(panX + dx, -maxPan, maxPan);
      panY = clamp(panY + dy, -maxPanY, maxPanY);
      applyTransform();
    }
  }, { passive: false });

  mapWrap.addEventListener('touchend', e => {
    if (e.touches.length < 2) pinchDist0 = null;
  });

  // ── Map click handler ──────────────────────────────────────────────────────
  mapWrap.addEventListener('click', e => {
    if (!running || answered || dragging) return;
    const path = e.target.closest('path[data-name]');
    if (!path) return;
    const rect = mapWrap.getBoundingClientRect();
    const vx = e.clientX - rect.left;
    const vy = e.clientY - rect.top;
    moveSheepTo(vx, vy);
    checkAnswer(path.dataset.name, vx, vy);
  });

  mapWrap.addEventListener('touchend', e => {
    if (!running || answered || pinchDist0 !== null) return;
    if (e.changedTouches.length !== 1) return;
    const touch = e.changedTouches[0];
    const el = document.elementFromPoint(touch.clientX, touch.clientY);
    const path = el && el.closest ? el.closest('path[data-name]') : null;
    if (!path) return;
    const rect = mapWrap.getBoundingClientRect();
    const vx = touch.clientX - rect.left;
    const vy = touch.clientY - rect.top;
    moveSheepTo(vx, vy);
    checkAnswer(path.dataset.name, vx, vy);
  }, { passive: true });

  // ── Sheep movement ─────────────────────────────────────────────────────────
  function moveSheepTo(vx, vy) {
    sheepX = vx;
    sheepY = vy;
    sheep.style.left = vx + 'px';
    sheep.style.top  = vy + 'px';
  }

  // Move sheep to SVG centroid of a state (for correct answer reveal)
  function moveSheepToCentroid(cx, cy) {
    // Convert SVG coords to viewport coords (reverse of toSvgCoords)
    const wrapW = mapWrap.offsetWidth;
    const wrapH = mapWrap.offsetHeight;
    const svgNatW = 960, svgNatH = 600;
    const scaleRatio = Math.min(wrapW / svgNatW, wrapH / svgNatH);
    const displayW = svgNatW * scaleRatio;
    const displayH = svgNatH * scaleRatio;
    const svgOriginX = (wrapW - displayW) / 2;
    const svgOriginY = (wrapH - displayH) / 2;
    const rawX = cx * scaleRatio + svgOriginX;
    const rawY = cy * scaleRatio + svgOriginY;
    // Apply inverse of zoom/pan transform
    const tcX = wrapW / 2;
    const tcY = wrapH / 2;
    const vx = (rawX - tcX) * zoom + tcX + panX * zoom;
    const vy = (rawY - tcY) * zoom + tcY + panY * zoom;
    moveSheepTo(
      clamp(vx, 20, wrapW - 20),
      clamp(vy, 20, wrapH - 20)
    );
  }

  // ── State flash ────────────────────────────────────────────────────────────
  function flashState(id, cls, duration) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add(cls);
    setTimeout(() => el.classList.remove(cls), duration);
  }

  // ── Answer check ───────────────────────────────────────────────────────────
  function checkAnswer(clickedName, vx, vy) {
    if (!currentState) return;
    if (clickedName === currentState.name) {
      correctAnswer(vx, vy);
    } else {
      wrongAnswer(clickedName);
    }
  }

  function correctAnswer(vx, vy) {
    answered = true;
    stopTimer();
    const elapsed = maxTime - timeLeft;
    let points = Math.round((timeLeft / maxTime) * MAX_SCORE_PER_ROUND);
    if (sportMode && elapsed < 5) points += SPORT_SPEED_BONUS;
    points = Math.max(0, points);
    score += points;
    roundResults.push({ correct: true, points });

    flashState(currentState.id, 'flash-correct', 1200);
    sheep.classList.remove('retreating');
    sheep.classList.add('celebrating');
    setTimeout(() => sheep.classList.remove('celebrating'), 700);
    moveSheepToCentroid(currentState.cx, currentState.cy);
    sfx('correct');
    floatScore('+' + points, vx, vy);
    corrLabel.textContent = `✅ ${currentState.name}! ${points > 0 ? '+' + points + ' pts' : 'Time up!'}`;
    updateScoreDisplay();

    // Achievements
    if (elapsed < 3) unlockAch('lightning');
    if (currentState.id === 'AK') unlockAch('alaska');
    if (currentState.tier === 'hard' && points >= 800) unlockAch('scholar');
    const streak = roundResults.slice(-5);
    if (streak.length === 5 && streak.every(r => r.correct)) unlockAch('streaker');

    setTimeout(() => advanceRound(), 1200);
  }

  function wrongAnswer(clickedName) {
    flashState(clickedName.replace(/ /g,'_') || '', 'flash-wrong', 600);
    // Find path by data-name
    const paths = mapCont.querySelectorAll('path[data-name]');
    for (const p of paths) {
      if (p.dataset.name === clickedName) {
        p.classList.add('flash-wrong');
        setTimeout(() => p.classList.remove('flash-wrong'), 600);
        break;
      }
    }
    sfx('wrong');
    showToast('Not that one — keep looking!', 800);
    corrLabel.textContent = `❌ That's ${clickedName} — keep searching!`;
  }

  // ── Timer ──────────────────────────────────────────────────────────────────
  function startTimer() {
    timerStartTs = performance.now();
    timerRaf = requestAnimationFrame(tickTimer);
  }

  function tickTimer(ts) {
    if (!running || answered) return;
    const elapsed = (ts - timerStartTs) / 1000;
    timeLeft = Math.max(0, maxTime - elapsed);
    const frac = timeLeft / maxTime;
    timerBar.style.transform = `scaleX(${frac})`;
    timerLbl.textContent = timeLeft.toFixed(1) + 's';
    if (timeLeft <= 5 && timeLeft > 0) {
      timerBar.classList.add('urgent');
      if (!MUTED && Math.floor(timeLeft * 2) !== Math.floor((timeLeft + 0.05) * 2)) sfxTick();
    } else {
      timerBar.classList.remove('urgent');
    }
    if (timeLeft <= 0) {
      timeOut();
      return;
    }
    timerRaf = requestAnimationFrame(tickTimer);
  }

  function stopTimer() {
    if (timerRaf) { cancelAnimationFrame(timerRaf); timerRaf = null; }
    timerBar.classList.remove('urgent');
  }

  function timeOut() {
    answered = true;
    stopTimer();
    roundResults.push({ correct: false, points: 0 });
    // Reveal correct state
    flashState(currentState.id, 'reveal-state', 1800);
    sfx('timeout');
    corrLabel.textContent = `⏱️ Time's up! It was ${currentState.name} ${currentState.emoji}`;
    updateScoreDisplay();
    setTimeout(() => advanceRound(), 1800);
  }

  // ── Round management ───────────────────────────────────────────────────────
  function buildRoundQueue() {
    const easy   = STATES.filter(s => s[5] === 'easy').map(s => [...s]);
    const medium = STATES.filter(s => s[5] === 'medium').map(s => [...s]);
    const hard   = STATES.filter(s => s[5] === 'hard').map(s => [...s]);

    shuffle(easy); shuffle(medium); shuffle(hard);

    const queue = [];
    // Sport mode: no tier distinction — just shuffle all
    if (sportMode) {
      const all = STATES.map(s => [...s]);
      shuffle(all);
      return all.slice(0, TOTAL_ROUNDS);
    }
    // Normal: 4 easy, 4 medium, 2 hard
    queue.push(...easy.slice(0, 4));
    queue.push(...medium.slice(0, 4));
    queue.push(...hard.slice(0, 2));
    return queue;
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
  }

  function beginRound() {
    const [id, name, emoji, cx, cy, tier] = roundQueue[roundIndex];
    currentState = { id, name, emoji, cx, cy, tier };
    answered = false;
    timeLeft = maxTime;
    timerBar.style.transform = 'scaleX(1)';
    timerLbl.textContent = maxTime.toFixed(1) + 's';
    timerBar.classList.remove('urgent');
    corrLabel.textContent = '';
    roundValEl.textContent = `${roundIndex + 1} / ${TOTAL_ROUNDS}`;
    updateRoundPips();
    showSign(name, emoji, () => {
      startTimer();
    });
  }

  function advanceRound() {
    roundIndex++;
    updateRoundPips();
    if (roundIndex >= TOTAL_ROUNDS) {
      endGame();
    } else {
      beginRound();
    }
  }

  // ── Sign animation ─────────────────────────────────────────────────────────
  function showSign(name, emoji, onReady) {
    stateSign.style.display = '';
    stateSign.textContent = `Find: ${name} ${emoji}`;
    stateSign.classList.remove('sign-arrive', 'sign-leave');
    void stateSign.offsetWidth; // force reflow
    stateSign.classList.add('sign-arrive');
    sfx('sign');
    setTimeout(() => { onReady && onReady(); }, 600);
  }

  // ── Round pips ────────────────────────────────────────────────────────────
  function updateRoundPips() {
    let html = '';
    for (let i = 0; i < TOTAL_ROUNDS; i++) {
      let cls = '';
      if (i < roundIndex) {
        cls = roundResults[i] && roundResults[i].correct ? 'done' : 'missed';
      } else if (i === roundIndex && running) {
        cls = 'current';
      }
      html += `<div class="round-pip ${cls}"></div>`;
    }
    roundPips.innerHTML = html;
  }

  // ── Score display ─────────────────────────────────────────────────────────
  function updateScoreDisplay() {
    scoreEl.textContent = score;
    if (score > personalBest) bestEl.textContent = score;
  }

  // ── Floating score popup ──────────────────────────────────────────────────
  function floatScore(text, vx, vy) {
    const el = document.createElement('div');
    el.className = 'map-score-pop' + (text === '+0' ? ' zero' : '');
    el.textContent = text;
    el.style.left = vx + 'px';
    el.style.top  = vy + 'px';
    mapWrap.appendChild(el);
    setTimeout(() => el.remove(), 1200);
  }

  // ── Feedback toast ─────────────────────────────────────────────────────────
  let toastTimer = null;
  function showToast(msg, dur) {
    fbToast.textContent = msg;
    fbToast.classList.add('visible');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => fbToast.classList.remove('visible'), dur || 1000);
  }

  // ── Start / end game ──────────────────────────────────────────────────────
  function startGame(sport) {
    sportMode = sport;
    maxTime = sport ? SPORT_TIME : NORMAL_TIME;
    score = 0;
    roundIndex = 0;
    roundResults = [];
    running = true;
    resetView();

    // Center sheep
    sheepX = mapWrap.offsetWidth / 2;
    sheepY = mapWrap.offsetHeight / 2;
    sheep.style.left = sheepX + 'px';
    sheep.style.top  = sheepY + 'px';
    sheep.style.transition = 'left 0.6s cubic-bezier(0.25,0.46,0.45,0.94), top 0.6s cubic-bezier(0.25,0.46,0.45,0.94)';

    resultOv.classList.remove('visible');
    modePopup.style.display = 'none';
    hudSub.textContent = sport ? '⚡ Sport mode' : 'Find all 10 states';
    scoreEl.textContent = 0;
    bestEl.textContent = personalBest > 0 ? personalBest : '—';
    corrLabel.textContent = '';

    if (GROUP_MODE) groupBadge.style.display = '';

    roundQueue = buildRoundQueue();
    updateRoundPips();
    beginRound();
  }

  function endGame() {
    running = false;
    stopTimer();
    corrLabel.textContent = '';
    stateSign.style.display = 'none';
    timerLbl.textContent = '';

    // Stats
    stats.games++;
    const correctCount = roundResults.filter(r => r.correct).length;
    stats.correct = (stats.correct || 0) + correctCount;
    if (score === 10000) { stats.perfect = (stats.perfect || 0) + 1; unlockAch('perfect'); }
    if (stats.games >= 10) unlockAch('explorer');
    const prevBest = stats.best || 0;
    if (score > prevBest) stats.best = score;
    personalBest = stats.best;
    saveStats(STATS_KEY, stats);

    // Grade
    const pct = score / (TOTAL_ROUNDS * MAX_SCORE_PER_ROUND);
    let grade, gradeEmo;
    if (pct >= 0.95) { grade = 'Geography Master!'; gradeEmo = '🏆'; }
    else if (pct >= 0.80) { grade = 'Expert Explorer'; gradeEmo = '🌟'; }
    else if (pct >= 0.60) { grade = 'Solid Navigator'; gradeEmo = '🗺️'; }
    else if (pct >= 0.40) { grade = 'Still Learning'; gradeEmo = '📚'; }
    else { grade = 'Keep Exploring!'; gradeEmo = '🐑'; }

    resultEmo.textContent = gradeEmo;
    resultBig.textContent = score.toLocaleString();
    resultLbl.textContent = 'out of 10,000';
    resultCorr.textContent = `${correctCount} / ${TOTAL_ROUNDS} states found`;
    resultGrd.textContent = grade;
    resultOv.classList.add('visible');
    sfx('end');
    updateRoundPips();

    // Leaderboard
    const lbRef = sportMode ? sportLb : lb;

    if (isNewBest(lbRef, score, LB_MAX)) {
      mpcScoreVal.textContent = score.toLocaleString();
      mpcScoreSub.textContent = grade;
      mpcScoreWrap.style.display = 'block';
      mpcNameRow.style.display = 'flex';
      mpcTitle.textContent = '🏆 New Best!';
      mpcSub.textContent = 'Enter your name for the leaderboard:';
      mpcNormal.style.display = 'none';
      mpcSport.style.display = 'none';
      modePopup.style.display = 'flex';
    } else {
      refreshLeaderboard();
    }
  }

  // ── Leaderboard helpers ────────────────────────────────────────────────────
  async function initLeaderboards() {
    if (!token) {
      try {
        const res = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=${window.__FB_KEY__}`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({returnSecureToken:true}) });
        const data = await res.json();
        token = data.idToken || null;
      } catch {}
    }
    lb      = loadLocalLeaderboard(LB_KEY, LB_MAX);
    sportLb = loadLocalLeaderboard(LB_SPORT, LB_MAX);
    try {
      lb      = await fetchLeaderboard({ dbUrl: DB,           localKey: LB_KEY,   max: LB_MAX }) || lb;
      sportLb = await fetchLeaderboard({ dbUrl: `${DB}/sport`, localKey: LB_SPORT, max: LB_MAX }) || sportLb;
    } catch {}
    bestEl.textContent = personalBest > 0 ? personalBest : '—';
  }

  function refreshLeaderboard() {
    const list = sportMode ? sportLb : lb;
    const titleEl = document.getElementById('lb-title');
    renderLeaderboard(document.getElementById('lb-list'), titleEl, list, sportMode ? 'Global · Sport' : 'Global · Normal');
  }

  // ── Mode popup & save ──────────────────────────────────────────────────────
  mpcNormal.addEventListener('click', () => startGame(false));
  mpcSport.addEventListener('click',  () => startGame(true));

  mpcSave.addEventListener('click', async () => {
    const raw = (mpcNameIn.value || '').trim().toUpperCase().replace(/[^A-Z0-9 ]/g,'');
    const name = raw.slice(0, 10) || 'ANON';
    const entry = { name, score };
    const lbRef  = sportMode ? sportLb : lb;
    const lbKey  = sportMode ? LB_SPORT : LB_KEY;
    const dbBase = sportMode ? `${DB}/sport` : DB;

    lbRef.push(entry);
    lbRef.sort((a,b) => b.score - a.score);
    if (lbRef.length > LB_MAX) lbRef.length = LB_MAX;
    saveLocalLeaderboard(lbKey, lbRef);
    try { await pushLeaderboard({ dbUrl: dbBase, localKey: lbKey, max: LB_MAX, lb: lbRef, token }); } catch {}

    modePopup.style.display = 'none';
    mpcNormal.style.display = '';
    mpcSport.style.display = '';
    mpcNameRow.style.display = 'none';
    mpcScoreWrap.style.display = 'none';
    mpcTitle.textContent = '🗺️ Sheep State Quest';
    mpcSub.textContent = 'Find all 50 US states on a blank map!';
    refreshLeaderboard();
  });

  document.getElementById('play-again-btn').addEventListener('click', () => {
    resultOv.classList.remove('visible');
    mpcTitle.textContent = '🗺️ Sheep State Quest';
    mpcSub.textContent = 'Play again?';
    mpcScoreWrap.style.display = 'none';
    mpcNameRow.style.display = 'none';
    mpcNormal.style.display = '';
    mpcSport.style.display = '';
    modePopup.style.display = 'flex';
  });

  document.getElementById('view-lb-btn').addEventListener('click', () => {
    refreshLeaderboard();
    document.getElementById('info-overlay').classList.add('visible');
    document.getElementById('info-drawer').classList.add('open');
  });

  // ── Stats / leaderboard drawer ─────────────────────────────────────────────
  statsBtn.addEventListener('click', () => {
    refreshLeaderboard();
    updateStatsPanel();
    renderAchievements();
    document.getElementById('info-overlay').classList.add('visible');
    document.getElementById('info-drawer').classList.add('open');
  });
  document.getElementById('info-close').addEventListener('click', closeDrawer);
  document.getElementById('info-overlay').addEventListener('click', closeDrawer);
  function closeDrawer() {
    document.getElementById('info-overlay').classList.remove('visible');
    document.getElementById('info-drawer').classList.remove('open');
  }

  function updateStatsPanel() {
    document.getElementById('stat-games').textContent   = stats.games || 0;
    document.getElementById('stat-best').textContent    = stats.best || 0;
    document.getElementById('stat-correct').textContent = stats.correct || 0;
    document.getElementById('stat-perfect').textContent = stats.perfect || 0;
  }

  function renderAchievements() {
    const list = document.getElementById('ach-list');
    list.innerHTML = ACHIEVEMENTS.map(a => `
      <div class="ach-item ${unlockedAch.has(a.id) ? 'unlocked' : 'locked'}">
        <span class="ach-icon">${a.icon}</span>
        <div><strong>${a.label}</strong><br><small>${a.desc}</small></div>
      </div>
    `).join('');
  }

  // ── Mute button (reuse shared pattern) ───────────────────────────────────
  // (The mute toggle lives in shared.css / game-framework; we wire it up here)
  document.addEventListener('keydown', e => {
    if (e.key === 'm' || e.key === 'M') {
      MUTED = !MUTED;
      localStorage.setItem(MUTE_KEY, MUTED ? '1' : '0');
    }
  });

  // ── Audio ──────────────────────────────────────────────────────────────────
  function sfx(type) {
    if (MUTED) return;
    const ctx = getAudioContext();
    if (!ctx) return;
    const now = ctx.currentTime;
    if (type === 'sign') {
      tone(ctx, 523, 'triangle', 0.12, now,       0.18);
      tone(ctx, 659, 'triangle', 0.12, now + 0.12, 0.18);
      tone(ctx, 784, 'triangle', 0.15, now + 0.24, 0.25);
    } else if (type === 'correct') {
      tone(ctx, 523, 'triangle', 0.14, now,       0.15);
      tone(ctx, 659, 'triangle', 0.14, now + 0.12, 0.15);
      tone(ctx, 784, 'triangle', 0.14, now + 0.24, 0.15);
      tone(ctx, 1047,'triangle', 0.18, now + 0.36, 0.3);
    } else if (type === 'wrong') {
      tone(ctx, 330, 'sawtooth', 0.12, now,       0.1);
      tone(ctx, 220, 'sawtooth', 0.10, now + 0.1, 0.15);
    } else if (type === 'timeout') {
      tone(ctx, 330, 'sawtooth', 0.12, now,        0.12);
      tone(ctx, 247, 'sawtooth', 0.12, now + 0.12, 0.12);
      tone(ctx, 196, 'sawtooth', 0.12, now + 0.24, 0.2);
    } else if (type === 'end') {
      [523, 659, 784, 1047].forEach((f, i) => {
        tone(ctx, f, 'triangle', 0.14, now + i * 0.1, 0.3);
      });
    }
  }

  function sfxTick() {
    if (MUTED) return;
    const ctx = getAudioContext();
    if (!ctx) return;
    tone(ctx, 440, 'sine', 0.07, ctx.currentTime, 0.06);
  }

  // ── Friends group ──────────────────────────────────────────────────────────
  document.getElementById('create-group-btn').addEventListener('click', async () => {
    const id = generateGroupId();
    const url = getGroupUrl(id);
    const wrap = document.getElementById('group-link-wrap');
    document.getElementById('group-link-display').textContent = url;
    wrap.style.display = '';
    document.getElementById('create-group-btn').style.display = 'none';
    try { await createGroupInFirebase(DB, id, token); } catch {}
  });

  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const net = btn.dataset.net;
      const url = document.getElementById('group-link-display').textContent;
      if (net === 'copy') {
        navigator.clipboard.writeText(url).then(() => showFriendsCopyToast());
      } else if (net === 'twitter') {
        window.open(`https://twitter.com/intent/tweet?text=Play+Sheep+State+Quest+with+me!&url=${encodeURIComponent(url)}`);
      }
    });
  });

  // ── Boot ───────────────────────────────────────────────────────────────────
  (async () => {
    await initLeaderboards();
    refreshLeaderboard();
    updateStatsPanel();
    renderAchievements();
    // Show mode picker
    mpcTitle.textContent = '🗺️ Sheep State Quest';
    mpcSub.textContent = 'Find all 50 US states on a blank map!';
    mpcNormal.style.display = '';
    mpcSport.style.display = '';
    mpcNameRow.style.display = 'none';
    mpcScoreWrap.style.display = 'none';
    modePopup.style.display = 'flex';
  })();

})();
</script>
</BaseLayout>
