  function injectStateLabels() {
    const svgEl = mapCont.querySelector('svg');
    if (!svgEl) return;
    STATE_EATS.forEach(([abbr,,,, cx, cy]) => {
      const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      txt.setAttribute('x', cx); txt.setAttribute('y', cy + 4);
      txt.setAttribute('text-anchor', 'middle'); txt.setAttribute('font-size', '11');
      txt.setAttribute('font-family', 'sans-serif'); txt.setAttribute('font-weight', '700');
      txt.setAttribute('fill', 'rgba(255,255,255,0.9)'); txt.setAttribute('pointer-events', 'none');
      txt.setAttribute('id', 'lbl-' + abbr); txt.textContent = abbr;
      svgEl.appendChild(txt);
    });
  }

  function dimState(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('state-used');
    const lbl = document.getElementById('lbl-' + id);
    if (lbl) lbl.setAttribute('fill', 'rgba(255,255,255,0.35)');
  }

  function clamp(v,lo,hi){return Math.max(lo,Math.min(hi,v));}
  function applyTransform(){mapCont.style.transform=`scale(${zoom}) translate(${panX}px,${panY}px)`;}
  function resetView(){zoom=1;panX=0;panY=0;applyTransform();}

  resetZoom.addEventListener('click', e=>{e.stopPropagation();resetView();});
  mapWrap.addEventListener('wheel', e=>{
    e.preventDefault();
    zoom=clamp(zoom*(e.deltaY>0?0.85:1.18),1,6); applyTransform();
  },{passive:false});
  mapWrap.addEventListener('mousedown',e=>{
    if(e.button!==0)return; dragging=true; dragLast={x:e.clientX,y:e.clientY};
    mapWrap.style.cursor='grabbing';
  });
  window.addEventListener('mousemove',e=>{
    if(!dragging)return;
    const dx=(e.clientX-dragLast.x)/zoom, dy=(e.clientY-dragLast.y)/zoom;
    dragLast={x:e.clientX,y:e.clientY};
    const mw=mapWrap.offsetWidth, mh=mapWrap.offsetHeight;
    panX=clamp(panX+dx,-((zoom-1)/zoom)*(mw/2)-40,((zoom-1)/zoom)*(mw/2)+40);
    panY=clamp(panY+dy,-((zoom-1)/zoom)*(mh/2)-40,((zoom-1)/zoom)*(mh/2)+40);
    applyTransform();
  });
  window.addEventListener('mouseup',()=>{dragging=false;mapWrap.style.cursor='crosshair';});

  mapWrap.addEventListener('touchstart',e=>{
    if(e.touches.length===2){
      e.preventDefault();
      pinchDist0=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      pinchZoom0=zoom;
    }else if(e.touches.length===1){dragLast={x:e.touches[0].clientX,y:e.touches[0].clientY};}
  },{passive:false});
  mapWrap.addEventListener('touchmove',e=>{
    e.preventDefault();
    if(e.touches.length===2&&pinchDist0!==null){
      const dist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      zoom=clamp(pinchZoom0*(dist/pinchDist0),1,6); applyTransform();
    }else if(e.touches.length===1&&dragLast){
      const dx=(e.touches[0].clientX-dragLast.x)/zoom,dy=(e.touches[0].clientY-dragLast.y)/zoom;
      dragLast={x:e.touches[0].clientX,y:e.touches[0].clientY};
      const mw=mapWrap.offsetWidth,mh=mapWrap.offsetHeight;
      panX=clamp(panX+dx,-((zoom-1)/zoom)*(mw/2)-40,((zoom-1)/zoom)*(mw/2)+40);
      panY=clamp(panY+dy,-((zoom-1)/zoom)*(mh/2)-40,((zoom-1)/zoom)*(mh/2)+40);
      applyTransform();
    }
  },{passive:false});
  mapWrap.addEventListener('touchend',e=>{if(e.touches.length<2)pinchDist0=null;});

  // ── Any state click triggers quiz ─────────────────────────────────────────
  function handleStateClick(path) {
    if (!running || answered) return;
    const entry = STATE_BY_NAME[path.dataset.name];
    if (!entry) return;
    if (usedStateIds.has(entry[0])) { showToast('Already played — pick another!', 900); return; }
    startQuiz(entry);
  }
  mapWrap.addEventListener('click',e=>{
    if(!running||answered||dragging)return;
    const path=e.target.closest('path[data-name]');
    if(path) handleStateClick(path);
  });
  mapWrap.addEventListener('touchend',e=>{
    if(!running||answered||pinchDist0!==null)return;
    if(e.changedTouches.length!==1)return;
    const t=e.changedTouches[0];
    const el=document.elementFromPoint(t.clientX,t.clientY);
    const path=el&&el.closest?el.closest('path[data-name]'):null;
    if(path) handleStateClick(path);
  },{passive:true});

  function startQuiz(entry) {
    const [id,name,domain,tier,cx,cy]=entry;
    currentState={id,name,domain,tier,cx,cy};
    answered=false; firstAttempt=true;
    usedStateIds.add(id);
    roundValEl.textContent=(roundIndex+1)+' / '+TOTAL_ROUNDS;
    updateRoundPips(); corrLabel.textContent='';
    showQuizPopup(domain,name);
    startTimer();
  }

  function buildQuizOptions(correctDomain){
    const d=ALL_DOMAINS.filter(x=>x!==correctDomain); shuffle(d);
    const opts=[correctDomain,...d.slice(0,3)]; shuffle(opts); return opts;
  }

  function showQuizPopup(correctDomain,stateName){
    const opts=buildQuizOptions(correctDomain);
    quizQuestion.textContent="What's "+stateName+"'s favorite fast food?";
    quizGrid.innerHTML='';
    opts.forEach(domain=>{
      const btn=document.createElement('button');
      btn.className='logo-card'; btn.dataset.domain=domain;
      const name=BRAND_NAMES[domain]||domain;
      const clearbit='https://logo.clearbit.com/'+domain;
      const gfav='https://www.google.com/s2/favicons?domain='+domain+'&sz=128';
      btn.innerHTML=
        '<div class="logo-img-wrap">'+
          '<img class="logo-img" src="'+clearbit+'" alt="'+name+'" '+
               'onerror="this.src=\''+gfav+'\';this.onerror=null;">'+
        '</div>'+
        '<div class="logo-name">'+name+'</div>';
      btn.addEventListener('click',()=>onLogoClick(domain,btn));
      quizGrid.appendChild(btn);
    });
    quizOverlay.classList.add('visible');
    timerLbl.textContent=maxTime.toFixed(1)+'s';
    timerBar.style.transform='scaleX(1)';
    timerBar.classList.remove('urgent');
  }

  function hideQuizPopup(){quizOverlay.classList.remove('visible');quizGrid.innerHTML='';}

  function onLogoClick(domain,cardEl){
    if(!running||answered)return;
    if(domain===currentState.domain){onLogoCorrect(cardEl);}else{onLogoWrong(cardEl);}
  }

  function onLogoCorrect(cardEl){
    answered=true; stopTimer();
    const elapsed=maxTime-timeLeft;
    let points=Math.round((timeLeft/maxTime)*MAX_SCORE_PER_ROUND);
    if(sportMode&&elapsed<5)points+=SPORT_SPEED_BONUS;
    const gotBonus=firstAttempt&&points>0;
    if(gotBonus)points+=FIRST_ATTEMPT_BONUS;
    points=Math.max(0,points);
    score+=points; roundResults.push({correct:true,points,firstAttempt});
    cardEl.classList.add('flash-correct-card');
    sfx('correct'); dimState(currentState.id);
    floatScore('+'+points,mapWrap.offsetWidth/2,mapWrap.offsetHeight*0.4);
    const bonusTag=gotBonus?' \U0001f3af +'+FIRST_ATTEMPT_BONUS+' first try!':'';
    corrLabel.textContent='✅ '+currentState.name+'!'+(points>0?' +'+points+' pts':'')+bonusTag;
    updateScoreDisplay();
    if(elapsed<3)unlockAch('lightning');
    if(currentState.id==='TX')unlockAch('texas');
    if(currentState.tier==='hard'&&points>=800)unlockAch('scholar');
    const streak=roundResults.slice(-5);
    if(streak.length===5&&streak.every(r=>r.correct))unlockAch('streaker');
    setTimeout(()=>{
      hideQuizPopup(); answered=false; roundIndex++;
      if(roundIndex>=TOTAL_ROUNDS){endGame();}
      else{updateRoundPips();hudSub.textContent='Click another state!';}
    },800);
  }

  function onLogoWrong(cardEl){
    answered=true;
    stopTimer();
    roundResults.push({correct:false,points:0});
    cardEl.classList.add('flash-wrong-card');
    sfx('wrong');
    dimState(currentState.id);
    // Show correct answer briefly before advancing
    const correctCard = quizGrid.querySelector('[data-domain="'+currentState.domain+'"]');
    if(correctCard) correctCard.classList.add('flash-correct-card');
    const brandName = BRAND_NAMES[currentState.domain]||currentState.domain;
    corrLabel.textContent = '❌ Wrong! '+currentState.name+' → '+brandName;
    updateScoreDisplay();
    setTimeout(()=>{
      hideQuizPopup(); answered=false; roundIndex++;
      if(roundIndex>=TOTAL_ROUNDS){endGame();}
      else{updateRoundPips();hudSub.textContent='Click another state!';}
    },1200);
  }

  function startTimer(){timerStartTs=performance.now();timerRaf=requestAnimationFrame(tickTimer);}
  function tickTimer(ts){
    if(!running||answered)return;
    const elapsed=(ts-timerStartTs)/1000;
    timeLeft=Math.max(0,maxTime-elapsed);
    timerBar.style.transform='scaleX('+(timeLeft/maxTime)+')';
    timerLbl.textContent=timeLeft.toFixed(1)+'s';
    if(timeLeft<=5&&timeLeft>0){
      timerBar.classList.add('urgent');
      if(!MUTED&&Math.floor(timeLeft*2)!==Math.floor((timeLeft+0.05)*2))sfxTick();
    }else{timerBar.classList.remove('urgent');}
    if(timeLeft<=0){timeOut();return;}
    timerRaf=requestAnimationFrame(tickTimer);
  }
  function stopTimer(){if(timerRaf){cancelAnimationFrame(timerRaf);timerRaf=null;}timerBar.classList.remove('urgent');}

  function timeOut(){
    answered=true; stopTimer();
    roundResults.push({correct:false,points:0});
    dimState(currentState.id);
    flashState(currentState.id,'reveal-state',1800);
    sfx('timeout');
    corrLabel.textContent='⏱️ Time\'s up! '+currentState.name+' → '+(BRAND_NAMES[currentState.domain]||currentState.domain);
    updateScoreDisplay();
    setTimeout(()=>{
      hideQuizPopup(); answered=false; roundIndex++;
      if(roundIndex>=TOTAL_ROUNDS){endGame();}
      else{updateRoundPips();hudSub.textContent='Click another state!';}
    },1800);
  }

  function flashState(id,cls,dur){
    const el=document.getElementById(id); if(!el)return;
    el.classList.add(cls); setTimeout(()=>el.classList.remove(cls),dur);
  }

  function updateRoundPips(){
    let h='';
    for(let i=0;i<TOTAL_ROUNDS;i++){
      let c='';
      if(i<roundIndex){c=roundResults[i]&&roundResults[i].correct?'done':'missed';}
      else if(i===roundIndex&&running){c='current';}
      h+='<div class="round-pip '+c+'"></div>';
    }
    roundPips.innerHTML=h;
  }

  function updateScoreDisplay(){
    scoreEl.textContent=score;
    if(score>personalBest)bestEl.textContent=score;
  }

  function floatScore(text,vx,vy){
    const el=document.createElement('div');
    el.className='map-score-pop'+(text==='+0'?' zero':'');
    el.textContent=text; el.style.left=vx+'px'; el.style.top=vy+'px';
    mapWrap.appendChild(el); setTimeout(()=>el.remove(),1200);
  }

  let toastTimer=null;
  function showToast(msg,dur){
    fbToast.textContent=msg; fbToast.classList.add('visible');
    if(toastTimer)clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>fbToast.classList.remove('visible'),dur||1000);
  }

  function shuffle(arr){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}}

  function startGame(sport){
    sportMode=sport; maxTime=sport?SPORT_TIME:NORMAL_TIME;
    score=0;roundIndex=0;roundResults=[];usedStateIds=new Set();running=true;
    resetView();hideQuizPopup();
    mapCont.querySelectorAll('.state-used').forEach(el=>el.classList.remove('state-used'));
    STATE_EATS.forEach(([abbr])=>{
      const lbl=document.getElementById('lbl-'+abbr);
      if(lbl)lbl.setAttribute('fill','rgba(255,255,255,0.9)');
    });
    resultOv.classList.remove('visible'); modeOverlay.style.display='none';
    hudSub.textContent=sport?'⚡ Click any state!':'Click any state to begin!';
    scoreEl.textContent=0; bestEl.textContent=personalBest>0?personalBest:'—';
    corrLabel.textContent=''; timerLbl.textContent='';
    timerBar.style.transform='scaleX(0)';
    if(GROUP_MODE)groupBadge.style.display='';
    updateRoundPips();
  }

  function endGame(){
    running=false; stopTimer(); hideQuizPopup();
    corrLabel.textContent=''; timerLbl.textContent='';
    stats.games++;
    const cc=roundResults.filter(r=>r.correct).length;
    stats.correct=(stats.correct||0)+cc;
    if(score===10000){stats.perfect=(stats.perfect||0)+1;unlockAch('perfect');}
    if(stats.games>=10)unlockAch('explorer');
    if(score>(stats.best||0))stats.best=score;
    personalBest=stats.best; saveStats(STATS_KEY,stats);
    const pct=score/(TOTAL_ROUNDS*MAX_SCORE_PER_ROUND);
    let grade,gradeEmo;
    if(pct>=0.95){grade='Fast Food Master!';gradeEmo='\U0001f3c6';}
    else if(pct>=0.80){grade='Food Expert';gradeEmo='\U0001f31f';}
    else if(pct>=0.60){grade='Solid Foodie';gradeEmo='\U0001f354';}
    else if(pct>=0.40){grade='Still Learning';gradeEmo='\U0001f4da';}
    else{grade='Keep Tasting!';gradeEmo='\U0001f35f';}
    resultEmo.textContent=gradeEmo;
    resultBig.textContent=score.toLocaleString();
    resultLbl.textContent='out of 10,000';
    resultCorr.textContent=cc+' / '+TOTAL_ROUNDS+' correct';
    resultGrd.textContent=grade;
    resultOv.classList.add('visible'); sfx('end'); updateRoundPips();
    const lbRef=sportMode?sportLb:lb;
    if(isNewBest(lbRef,score,LB_MAX)){
      mpcScoreVal.textContent=score.toLocaleString(); mpcScoreSub.textContent=grade;
      mpcScoreWrap.style.display='block'; mpcNameRow.style.display='flex';
      mpcTitle.textContent='\U0001f3c6 New Best!';
      mpcSub.textContent='Enter your name for the leaderboard:';
      mpcNormal.style.display='none'; mpcSport.style.display='none';
      modeOverlay.style.display='flex';
    }else{refreshLeaderboard();}
  }

  async function initLeaderboards(){
    if(!token){
      try{
        const res=await fetch('https://identitytoolkit.googleapis.com/v1/accounts:signUp?key='+window.__FB_KEY__,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({returnSecureToken:true})});
        token=(await res.json()).idToken||null;
      }catch{}
    }
    lb=loadLocalLeaderboard(LB_KEY,LB_MAX);
    sportLb=loadLocalLeaderboard(LB_SPORT,LB_MAX);
    try{
      lb=await fetchLeaderboard({dbUrl:DB,localKey:LB_KEY,max:LB_MAX})||lb;
      sportLb=await fetchLeaderboard({dbUrl:DB+'/sport',localKey:LB_SPORT,max:LB_MAX})||sportLb;
    }catch{}
    bestEl.textContent=personalBest>0?personalBest:'—';
  }

  function refreshLeaderboard(){
    renderLeaderboard(document.getElementById('lb-list'),document.getElementById('lb-title'),
      sportMode?sportLb:lb,sportMode?'Global · Sport':'Global · Normal');
  }

  mpcNormal.addEventListener('click',()=>startGame(false));
  mpcSport.addEventListener('click', ()=>startGame(true));

  mpcSave.addEventListener('click',async()=>{
    const raw=(mpcNameIn.value||'').trim().toUpperCase().replace(/[^A-Z0-9 ]/g,'');
    const name=raw.slice(0,10)||'ANON';
    const entry={name,score};
    const lbRef=sportMode?sportLb:lb, lbKey=sportMode?LB_SPORT:LB_KEY, dbBase=sportMode?DB+'/sport':DB;
    lbRef.push(entry); lbRef.sort((a,b)=>b.score-a.score);
    if(lbRef.length>LB_MAX)lbRef.length=LB_MAX;
    saveLocalLeaderboard(lbKey,lbRef);
    try{await pushLeaderboard({dbUrl:dbBase,localKey:lbKey,max:LB_MAX,lb:lbRef,token});}catch{}
    modeOverlay.style.display='none'; mpcNormal.style.display=''; mpcSport.style.display='';
    mpcNameRow.style.display='none'; mpcScoreWrap.style.display='none';
    mpcTitle.textContent='\U0001f354 State Eats Quest';
    mpcSub.textContent='Click any state & pick its fast food!';
    refreshLeaderboard();
  });

  document.getElementById('play-again-btn').addEventListener('click',()=>{
    resultOv.classList.remove('visible');
    mpcTitle.textContent='\U0001f354 State Eats Quest'; mpcSub.textContent='Play again?';
    mpcScoreWrap.style.display='none'; mpcNameRow.style.display='none';
    mpcNormal.style.display=''; mpcSport.style.display='';
    modeOverlay.style.display='flex';
  });
  document.getElementById('view-lb-btn').addEventListener('click',()=>{
    refreshLeaderboard();
    document.getElementById('info-overlay').classList.add('visible');
    document.getElementById('info-drawer').classList.add('open');
  });
  statsBtn.addEventListener('click',()=>{
    refreshLeaderboard();updateStatsPanel();renderAchievements();
    document.getElementById('info-overlay').classList.add('visible');
    document.getElementById('info-drawer').classList.add('open');
  });
  document.getElementById('info-close').addEventListener('click',closeDrawer);
  document.getElementById('info-overlay').addEventListener('click',closeDrawer);
  function closeDrawer(){
    document.getElementById('info-overlay').classList.remove('visible');
    document.getElementById('info-drawer').classList.remove('open');
  }
  function updateStatsPanel(){
    document.getElementById('stat-games').textContent  =stats.games||0;
    document.getElementById('stat-best').textContent   =stats.best||0;
    document.getElementById('stat-correct').textContent=stats.correct||0;
    document.getElementById('stat-perfect').textContent=stats.perfect||0;
  }
  function renderAchievements(){
    document.getElementById('ach-list').innerHTML=ACHIEVEMENTS.map(a=>
      '<div class="ach-item '+(unlockedAch.has(a.id)?'unlocked':'locked')+'">'
      +'<span class="ach-icon">'+a.icon+'</span>'
      +'<div><strong>'+a.label+'</strong><br><small>'+a.desc+'</small></div></div>'
    ).join('');
  }

  document.addEventListener('keydown',e=>{
    if(e.key==='m'||e.key==='M'){MUTED=!MUTED;localStorage.setItem(MUTE_KEY,MUTED?'1':'0');}
  });

  function sfx(type){
    if(MUTED)return; const ctx=getAudioContext();if(!ctx)return;
    const now=ctx.currentTime;
    if(type==='correct'){
      tone(ctx,523,'triangle',0.14,now,0.15);tone(ctx,659,'triangle',0.14,now+0.12,0.15);
      tone(ctx,784,'triangle',0.14,now+0.24,0.15);tone(ctx,1047,'triangle',0.18,now+0.36,0.3);
    }else if(type==='wrong'){
      tone(ctx,330,'sawtooth',0.12,now,0.1);tone(ctx,220,'sawtooth',0.10,now+0.1,0.15);
    }else if(type==='timeout'){
      tone(ctx,330,'sawtooth',0.12,now,0.12);tone(ctx,247,'sawtooth',0.12,now+0.12,0.12);
      tone(ctx,196,'sawtooth',0.12,now+0.24,0.2);
    }else if(type==='end'){[523,659,784,1047].forEach((f,i)=>tone(ctx,f,'triangle',0.14,now+i*0.1,0.3));}
  }
  function sfxTick(){if(MUTED)return;const ctx=getAudioContext();if(!ctx)return;tone(ctx,440,'sine',0.07,ctx.currentTime,0.06);}

  document.getElementById('create-group-btn').addEventListener('click',async()=>{
    const id=generateGroupId(),url=getGroupUrl(id);
    document.getElementById('group-link-display').textContent=url;
    document.getElementById('group-link-wrap').style.display='';
    document.getElementById('create-group-btn').style.display='none';
    try{await createGroupInFirebase(DB,id,token);}catch{}
  });
  document.querySelectorAll('.share-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const url=document.getElementById('group-link-display').textContent;
      if(btn.dataset.net==='copy')navigator.clipboard.writeText(url).then(()=>showFriendsCopyToast());
      else if(btn.dataset.net==='twitter')window.open('https://twitter.com/intent/tweet?text=Play+State+Eats+Quest+with+me!&url='+encodeURIComponent(url));
    });
  });

  (async()=>{
    await initLeaderboards(); refreshLeaderboard(); updateStatsPanel(); renderAchievements();
    mpcTitle.textContent='\U0001f354 State Eats Quest';
    mpcSub.textContent='Click any state & pick its fast food!';
    mpcNormal.style.display=''; mpcSport.style.display='';
    mpcNameRow.style.display='none'; mpcScoreWrap.style.display='none';
    modeOverlay.style.display='flex';
  })();

})();
</script>
</BaseLayout>
