---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/shared.css';
import '../../styles/state-eats.css';
const firebaseApiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "@id": "https://sheeps.online/state-eats/#game",
      "name": "State Eats Quest",
      "url": "https://sheeps.online/state-eats/",
      "description": "Click any US state on the map to reveal a fast food quiz. Pick the chain most popular in that state from four real logo choices.",
      "genre": ["Casual", "Educational", "Trivia", "Geography"],
      "playMode": "SinglePlayer",
      "applicationCategory": "Game",
      "operatingSystem": "Any",
      "gamePlatform": "Web Browser",
      "isAccessibleForFree": true,
      "inLanguage": "en",
      "image": "https://sheeps.online/og-image.svg",
      "publisher": {
        "@type": "Organization",
        "@id": "https://sheeps.online/#organization",
        "name": "Sheeps.online",
        "url": "https://sheeps.online/"
      },
      "audience": { "@type": "PeopleAudience", "suggestedMinAge": 8 }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Free Games", "item": "https://sheeps.online/" },
        { "@type": "ListItem", "position": 2, "name": "State Eats Quest", "item": "https://sheeps.online/state-eats/" }
      ]
    }
  ]
});
---
<BaseLayout
  title="State Eats Quest — USA Fast Food Trivia Game | Sheeps.online"
  description="Click any US state on the map and pick its favorite fast food from four logo choices. Can you name all 50? Free browser trivia game."
>
  <Fragment slot="head">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍔</text></svg>">
    <script type="application/ld+json" set:html={schema} />
    <script is:inline src="/scripts/game-framework.js"></script>
  </Fragment>

<div class="app">
  <h1>🍔 State Eats Quest</h1>
  <p class="tagline">Click any state — then pick its favorite fast food! 🗺️</p>

  <div class="ad-wrap ad-wrap--top"></div>

  <div id="game-container">

    <div class="topbar">
      <div class="topbar-left">
        <span id="group-badge" style="display:none">👥 Group Mode</span>
        <div>
          <div class="hud-title">🍔 State Eats</div>
          <div class="hud-subtitle" id="hud-subtitle">Click a state to begin</div>
        </div>
      </div>
      <div class="stat-group">
        <div class="stat"><div class="stat-label">Score</div><div class="stat-value" id="score-display">0</div></div>
        <div class="stat"><div class="stat-label">Your best</div><div class="stat-value" id="best-display">—</div></div>
        <div class="stat" id="round-stat"><div class="stat-label">Round</div><div class="stat-value" id="round-display-val">—</div></div>
      </div>
    </div>

    <div id="sign-wrap"><div id="state-sign" style="display:none"></div></div>

    <div id="timer-label"></div>
    <div id="timer-bar-wrap"><div id="timer-bar"></div></div>
    <div id="round-display"></div>

    <div id="map-wrap">
      <div id="map-svg-container"></div>
      <div id="compass">🧭</div>
      <button id="reset-zoom">🔍 Reset</button>
      <div id="feedback-toast"></div>
      <div id="quiz-overlay">
        <div id="quiz-popup">
          <div id="quiz-question"></div>
          <div id="quiz-grid"></div>
        </div>
      </div>
      <div id="result-overlay">
        <div style="font-size:48px" id="result-emoji">🍔</div>
        <div id="result-score-big">0</div>
        <div id="result-label">out of 10,000</div>
        <div id="result-correct"></div>
        <div id="result-grade" style="font-size:22px;font-weight:700;margin-top:4px"></div>
        <div style="display:flex;gap:10px;margin-top:12px">
          <button class="card-btn" id="play-again-btn">Play Again</button>
          <button class="card-btn" id="view-lb-btn">Leaderboard</button>
        </div>
      </div>
    </div>

    <div id="state-correct-label" class="state-correct-label"></div>

    <details>
      <summary>How to play</summary>
      <p>All 50 US states are labeled on the map. Click any state to get a fast food question: four real logos appear and you need to pick the chain most popular in that state. You have 20 seconds per question. The faster you answer, the more points you score (up to 1,000 per round, 10 rounds total).</p>
      <p>Pick the wrong logo? Try again while the timer runs. When time runs out the correct answer is revealed.</p>
      <p><strong>Sport mode ⚡:</strong> 15 seconds per question and a +200 speed bonus if you answer in the first 5 seconds.</p>
    </details>
  </div>
</div>

<div id="mode-overlay">
  <div id="mode-popup">
    <div class="mode-popup-inner">
      <div class="mode-popup-title" id="mode-popup-title">🍔 State Eats Quest</div>
      <div class="mode-popup-sub" id="mode-popup-sub">Click any state &amp; pick its fast food!</div>
      <div class="mode-popup-score" id="mode-popup-score" style="display:none">
        <div id="mode-popup-score-val"></div>
        <div id="mode-popup-score-sub"></div>
      </div>
      <div class="mode-btn-row">
        <button id="mpc-normal" class="mode-btn"><span class="mode-btn-icon">🗺️</span>Normal</button>
        <button id="mpc-sport"  class="mode-btn"><span class="mode-btn-icon">⚡</span>Sport</button>
      </div>
      <div id="mpc-name-row" class="name-entry" style="display:none">
        <input id="mpc-name" class="name-input" type="text" maxlength="10" placeholder="YOUR NAME" autocomplete="off" spellcheck="false">
        <button id="mpc-save" class="card-btn">Save score</button>
      </div>
    </div>
  </div>
</div>

<div id="info-overlay"></div>
<div id="info-drawer">
  <div id="info-drawer-header">
    <span>Leaderboard &amp; Stats</span>
    <button id="info-close">✕</button>
  </div>
  <div class="info-section">
    <div class="info-section-title" id="lb-title">Global &middot; Normal</div>
    <div id="lb-list"></div>
    <div id="lb-friends-wrap" style="display:none">
      <div class="info-section-title" style="margin-top:16px">Friend Group</div>
      <div id="lb-friends-list"></div>
    </div>
  </div>
  <div class="info-section">
    <div class="info-section-title">Your Stats</div>
    <div id="stats-grid" class="stats-grid">
      <div class="stat-cell"><span id="stat-games">0</span><label>Games</label></div>
      <div class="stat-cell"><span id="stat-best">0</span><label>Best score</label></div>
      <div class="stat-cell"><span id="stat-correct">0</span><label>States answered</label></div>
      <div class="stat-cell"><span id="stat-perfect">0</span><label>Perfect rounds</label></div>
    </div>
  </div>
  <div class="info-section" id="ach-section">
    <div class="info-section-title">Achievements</div>
    <div id="ach-list"></div>
  </div>
  <div class="info-section friends-section">
    <div class="info-section-title">Play with friends</div>
    <p class="friends-desc">Create a group leaderboard and share it with friends. Scores stay for 10 days.</p>
    <div id="friends-actions">
      <button id="create-group-btn" class="card-btn">Create friend group</button>
      <div id="group-link-wrap" style="display:none">
        <div id="group-link-display" class="group-link-display"></div>
        <div class="share-row">
          <button class="share-btn" data-net="twitter">𝕏 Twitter</button>
          <button class="share-btn" data-net="copy">📋 Copy</button>
        </div>
      </div>
    </div>
  </div>
</div>

<button id="stats-btn" title="Leaderboard &amp; stats">☰</button>

<script define:vars={{ firebaseApiKey }}>window.__FB_KEY__ = firebaseApiKey;</script>
