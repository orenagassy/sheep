    { id:'scholar',   icon:'\U0001f393', label:'Food Scholar',  desc:'Score 800+ on a hard state' },
  ];
  let unlockedAch = new Set(JSON.parse(localStorage.getItem('stateeats:ach') || '[]'));
  function unlockAch(id) {
    if (unlockedAch.has(id)) return;
    unlockedAch.add(id);
    localStorage.setItem('stateeats:ach', JSON.stringify([...unlockedAch]));
    const a = ACHIEVEMENTS.find(x => x.id === id);
