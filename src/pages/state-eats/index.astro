  const ACHIEVEMENTS = [
    { id:'lightning', icon:'⚡', label:'Lightning Round', desc:'Answer in under 3 seconds' },
    { id:'perfect',   icon:'\U0001f4af', label:'Perfect Score',   desc:'Score 10,000 in one game' },
