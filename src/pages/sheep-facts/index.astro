---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sheepFacts } from '../../data/sheepFacts.js';

const title = '250 Funny Sheep Facts for Kids & Adults | Sheeps.online';
const description = 'Discover 250 hilarious sheep facts for kids and grown-ups! From rectangular pupils to a $490,000 ram, these baa-rilliant facts will blow your woolly mind.';

const categories = [
  { id: 'basics',       label: 'The Basics',                    emoji: '🐑', start: 0,   end: 25  },
  { id: 'bodies',       label: 'Bodies, Breeds & Lifespans',    emoji: '🦷', start: 25,  end: 50  },
  { id: 'wool',         label: 'Wool & Products',               emoji: '🧶', start: 50,  end: 75  },
  { id: 'intelligence', label: 'Intelligence & Farm Life',      emoji: '🧠', start: 75,  end: 100 },
  { id: 'senses',       label: 'Senses & Social Life',          emoji: '👂', start: 100, end: 125 },
  { id: 'quirks',       label: 'Quirks & Surprises',            emoji: '🤔', start: 125, end: 150 },
  { id: 'work',         label: 'Sheep at Work',                 emoji: '🌱', start: 150, end: 175 },
  { id: 'history',      label: 'History & Culture',             emoji: '📜', start: 175, end: 200 },
  { id: 'records',      label: 'Records & Big Numbers',         emoji: '🏆', start: 200, end: 225 },
  { id: 'world',        label: 'Sheep Around the World',        emoji: '🌍', start: 225, end: 250 },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://sheeps.online/sheep-facts/#article",
      "headline": "250 Funny Sheep Facts for Kids & Adults",
      "description": description,
      "url": "https://sheeps.online/sheep-facts/",
      "inLanguage": "en",
      "datePublished": "2026-05-30",
      "dateModified": "2026-05-30",
      "author": {
        "@type": "Organization",
        "name": "Sheeps.online Editorial Team",
        "url": "https://sheeps.online/about/"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://sheeps.online/#organization",
        "name": "Sheeps.online",
        "url": "https://sheeps.online/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://sheeps.online/sheep-facts/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sheeps.online/" },
        { "@type": "ListItem", "position": 2, "name": "250 Sheep Facts", "item": "https://sheeps.online/sheep-facts/" }
      ]
    }
  ]
});
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐑</text></svg>" />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: #f5f1e8;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: #2c2c2a;
    }
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    /* ---- Hero ---- */
    .hero {
      text-align: center;
      padding: 52px 0 32px;
    }
    .sheep-parade {
      display: block;
      font-size: 42px;
      letter-spacing: 8px;
      margin-bottom: 20px;
      animation: graze 3s ease-in-out infinite;
    }
    @keyframes graze {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-7px); }
    }
    h1 {
      font-size: 42px;
      font-weight: 800;
      margin: 0 0 10px;
      line-height: 1.1;
      color: #2c2c2a;
    }
    .hero-sub {
      font-size: 19px;
      color: #4a9e6b;
      font-weight: 600;
      margin: 0 0 8px;
    }
    .byline {
      font-size: 13px;
      color: #6b6961;
      margin: 0 0 20px;
    }
    .hero-intro {
      max-width: 660px;
      margin: 0 auto 28px;
      font-size: 15px;
      color: #6b6961;
      line-height: 1.7;
    }
    .stat-pills {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .pill {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.09);
      border-radius: 40px;
      padding: 7px 18px;
      font-size: 13px;
      font-weight: 600;
      color: #2c2c2a;
      white-space: nowrap;
    }

    /* ---- Anchor nav ---- */
    .anchor-nav {
      background: #fff;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.08);
      padding: 20px 24px;
      margin: 32px 0 48px;
    }
    .anchor-nav-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #4a9e6b;
      margin: 0 0 12px;
      display: block;
    }
    .anchor-nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .anchor-nav-links a {
      font-size: 13px;
      font-weight: 600;
      color: #2c2c2a;
      text-decoration: none;
      background: #f5f1e8;
      border-radius: 20px;
      padding: 5px 14px;
      transition: background 0.15s, color 0.15s;
    }
    .anchor-nav-links a:hover { background: #4a9e6b; color: #fff; }

    /* ---- Category sections ---- */
    .category-section {
      margin-bottom: 56px;
    }
    .category-heading {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 20px;
      color: #2c2c2a;
      scroll-margin-top: 24px;
    }
    .category-emoji {
      font-size: 26px;
      flex-shrink: 0;
    }

    /* ---- Facts grid ---- */
    .facts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 12px;
    }
    .fact-card {
      background: #fff;
      border-radius: 12px;
      padding: 18px 20px;
      border: 1px solid rgba(0,0,0,0.08);
      display: flex;
      gap: 13px;
      align-items: flex-start;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .fact-card:hover {
      box-shadow: 0 4px 18px rgba(0,0,0,0.09);
      transform: translateY(-2px);
    }
    .fact-num {
      flex-shrink: 0;
      width: 30px;
      height: 30px;
      background: #4a9e6b;
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      margin-top: 1px;
    }
    .fact-text {
      font-size: 14px;
      color: #2c2c2a;
      line-height: 1.65;
      margin: 0;
    }

    /* ---- Game cross-links ---- */
    .game-links-section {
      background: #fff;
      border-radius: 12px;
      padding: 24px 28px;
      border: 1px solid rgba(0,0,0,0.08);
      margin-bottom: 32px;
    }
    .game-links-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #4a9e6b;
      margin: 0 0 14px;
      display: block;
    }
    .game-links-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 10px;
    }
    .game-link-card {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #f5f1e8;
      border-radius: 10px;
      padding: 12px 16px;
      text-decoration: none;
      color: #2c2c2a;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.15s, transform 0.12s;
    }
    .game-link-card:hover { background: #efeadd; transform: translateY(-1px); }
    .game-link-icon { font-size: 22px; flex-shrink: 0; }

    /* ---- Games banner ---- */
    .games-banner {
      background: #fff;
      border-radius: 12px;
      padding: 24px 28px;
      border: 1px solid rgba(0,0,0,0.08);
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 32px;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .games-banner:hover {
      box-shadow: 0 4px 18px rgba(0,0,0,0.09);
      transform: translateY(-2px);
    }
    .games-banner-icon { font-size: 48px; line-height: 1; flex-shrink: 0; }
    .games-banner-body { flex: 1; }
    .games-banner-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #4a9e6b;
      margin: 0 0 4px;
      display: block;
    }
    .games-banner-title {
      font-size: 17px;
      font-weight: 700;
      margin: 0 0 4px;
      color: #2c2c2a;
    }
    .games-banner-desc {
      font-size: 13px;
      color: #6b6961;
      margin: 0;
    }
    .games-banner-arrow {
      font-size: 22px;
      color: #4a9e6b;
      flex-shrink: 0;
    }

    /* ---- Footer nav ---- */
    .page-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding-top: 20px;
      border-top: 1px solid rgba(0,0,0,0.08);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #4a9e6b;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      transition: opacity 0.15s;
    }
    .back-link:hover { opacity: 0.72; }
    .footer-links {
      display: flex;
      gap: 16px;
      font-size: 13px;
    }
    .footer-links a { color: #6b6961; text-decoration: none; }
    .footer-links a:hover { color: #4a9e6b; }

    @media (max-width: 640px) {
      h1 { font-size: 30px; }
      .hero-sub { font-size: 16px; }
      .sheep-parade { font-size: 30px; letter-spacing: 4px; }
      .facts-grid { grid-template-columns: 1fr; gap: 10px; }
      .category-heading { font-size: 18px; }
      main { padding: 0 16px 56px; }
      .games-banner { flex-direction: column; gap: 12px; }
    }
  </style>

  <main>
    <!-- Hero -->
    <div class="hero">
      <span class="sheep-parade" aria-hidden="true">🐑 🐑 🐑 🐑 🐑</span>
      <h1>250 Funny Sheep Facts</h1>
      <p class="hero-sub">Baa-rilliant trivia for kids &amp; adults</p>
      <p class="byline">By Sheeps.online Editorial Team · Published May 2026</p>
      <p class="hero-intro">
        Think sheep are just boring fluffy lawn mowers? These 250 facts cover everything from rectangular pupils and four-chambered stomachs to the $490,000 ram, the sheep that rode in the world's first hot air balloon, and the Chinese flock that walked in circles for two weeks. Prepare to be surprised.
      </p>
      <div class="stat-pills">
        <span class="pill">🐑 250 Facts</span>
        <span class="pill">🌍 ~1 Billion Sheep on Earth</span>
        <span class="pill">📅 Friends Since 11,000 BC</span>
        <span class="pill">🧠 10 Categories</span>
      </div>
    </div>

    <!-- Anchor navigation -->
    <nav class="anchor-nav" aria-label="Jump to category">
      <span class="anchor-nav-label">Jump to category</span>
      <div class="anchor-nav-links">
        {categories.map(cat => (
          <a href={`#${cat.id}`}>{cat.emoji} {cat.label}</a>
        ))}
      </div>
    </nav>

    <!-- Facts by category -->
    {categories.map(cat => (
      <section class="category-section" id={cat.id} aria-label={cat.label}>
        <h2 class="category-heading">
          <span class="category-emoji" aria-hidden="true">{cat.emoji}</span>
          {cat.label}
        </h2>
        <div class="facts-grid">
          {sheepFacts.slice(cat.start, cat.end).map((fact, i) => (
            <div class="fact-card">
              <div class="fact-num">{cat.start + i + 1}</div>
              <p class="fact-text">{fact}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Cross-links to games -->
    <div class="game-links-section">
      <span class="game-links-label">Now go test your knowledge</span>
      <div class="game-links-grid">
        <a href="/state-quest/" class="game-link-card">
          <span class="game-link-icon">🐑🗺️</span>
          Sheep State Quest
        </a>
        <a href="/state-eats/" class="game-link-card">
          <span class="game-link-icon">🗺️🍔</span>
          State Eats Quest
        </a>
        <a href="/sheep-gates/" class="game-link-card">
          <span class="game-link-icon">🐑🐺</span>
          Sheep Gates
        </a>
        <a href="/fat-sheep/" class="game-link-card">
          <span class="game-link-icon">🐑🌿</span>
          Fat Grazing Sheep
        </a>
      </div>
    </div>

    <!-- Games link -->
    <a href="/" class="games-banner" aria-label="Play free sheep games at Sheeps.online">
      <div class="games-banner-icon" aria-hidden="true">🎮🐑</div>
      <div class="games-banner-body">
        <span class="games-banner-label">Now go play!</span>
        <p class="games-banner-title">Free Sheep Games at Sheeps.online</p>
        <p class="games-banner-desc">Sheep Gates, Fat Grazing Sheep, Plop Drop, State Quest, State Eats Quest. All free, no install.</p>
      </div>
      <span class="games-banner-arrow" aria-hidden="true">→</span>
    </a>

    <!-- Footer nav -->
    <div class="page-footer">
      <a href="/" class="back-link">← Back to games</a>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
  </main>
</BaseLayout>
