---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Free Online Sheep Games for Kids & Adults | Casual Browser Games | Sheeps.online';
const description = 'Play free online games at Sheeps.online! Fun casual games for kids and adults. No download, no signup. Pick a game and play instantly in your browser.';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://sheeps.online/#website",
      "url": "https://sheeps.online/",
      "name": "Sheeps.online",
      "description": "Free online casual games for kids and adults. Play browser games instantly, no download required.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://sheeps.online/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sheeps.online/#organization",
      "name": "Sheeps.online",
      "url": "https://sheeps.online/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://sheeps.online/og-image.svg"
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://sheeps.online/#gamelist",
      "name": "Free Online Games",
      "description": "A collection of free casual web games playable directly in any browser.",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "VideoGame",
            "@id": "https://sheeps.online/sheep-gates/#game",
            "name": "Sheep Gates",
            "url": "https://sheeps.online/sheep-gates/",
            "description": "Pick the open gate, dodge the wolves, and survive as long as you can. A fast-paced casual browser game perfect for kids and adults.",
            "genre": ["Casual", "Action", "Arcade", "Kids"],
            "playMode": "SinglePlayer",
            "applicationCategory": "Game",
            "operatingSystem": "Any",
            "gamePlatform": "Web Browser",
            "isAccessibleForFree": true,
            "image": "https://sheeps.online/og-image.svg",
            "audience": {
              "@type": "PeopleAudience",
              "suggestedMinAge": 5
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "VideoGame",
            "@id": "https://sheeps.online/fat-sheep/#game",
            "name": "Fat Grazing Sheep",
            "url": "https://sheeps.online/fat-sheep/",
            "description": "Guide your sheep around a pasture, eat food, grow enormous, and dodge the sheepdogs. A casual browser game with 6 fat stages and power-ups.",
            "genre": ["Casual", "Kids"],
            "playMode": "SinglePlayer",
            "applicationCategory": "Game",
            "operatingSystem": "Any",
            "gamePlatform": "Web Browser",
            "isAccessibleForFree": true,
            "image": "https://sheeps.online/og-image.svg",
            "audience": {
              "@type": "PeopleAudience",
              "suggestedMinAge": 5
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "VideoGame",
            "@id": "https://sheeps.online/plop-drop/#game",
            "name": "Plop Drop",
            "url": "https://sheeps.online/plop-drop/",
            "description": "Drone sheep are flying overhead dropping plops. Move your toilet seat to catch them all! Casual browser game with combos and power-ups.",
            "genre": ["Casual", "Arcade", "Kids"],
            "playMode": "SinglePlayer",
            "applicationCategory": "Game",
            "operatingSystem": "Any",
            "gamePlatform": "Web Browser",
            "isAccessibleForFree": true,
            "image": "https://sheeps.online/og-image.svg",
            "audience": {
              "@type": "PeopleAudience",
              "suggestedMinAge": 5
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "item": {
            "@type": "VideoGame",
            "@id": "https://sheeps.online/state-quest/#game",
            "name": "Sheep State Quest",
            "url": "https://sheeps.online/state-quest/",
            "description": "Guide your sheep to the correct US state on a blank map! A wooden sign names the target state, the clock starts ticking — zoom in and click before time runs out.",
            "genre": ["Casual", "Educational", "Geography", "Kids"],
            "playMode": "SinglePlayer",
            "applicationCategory": "Game",
            "operatingSystem": "Any",
            "gamePlatform": "Web Browser",
            "isAccessibleForFree": true,
            "image": "https://sheeps.online/og-image.svg",
            "audience": {
              "@type": "PeopleAudience",
              "suggestedMinAge": 7
            }
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are the games free to play?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All games on Sheeps.online are completely free to play. No registration or payment required."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to download anything to play?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. All games run directly in your web browser, on desktop, tablet, or mobile. Nothing to install."
          }
        },
        {
          "@type": "Question",
          "name": "Are these games suitable for kids?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Our games are designed to be fun and safe for kids of all ages, as well as casual adult gamers."
          }
        },
        {
          "@type": "Question",
          "name": "What devices can I play on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sheeps.online games work on any modern device: PC, Mac, smartphone, or tablet. Just open your browser and play."
          }
        }
      ]
    }
  ]
});
---
<BaseLayout {title} {description}>
  <Fragment slot="head">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: #f5f1e8;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: #2c2c2a;
    }
    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 24px 64px;
    }
    h1 {
      font-size: 32px;
      font-weight: 700;
      margin: 0 0 8px;
      line-height: 1.2;
    }
    h2 {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 12px;
      color: #2c2c2a;
    }
    .subtitle {
      color: #6b6961;
      margin: 0 0 40px;
      font-size: 15px;
    }
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
      margin-bottom: 56px;
    }
    .game-card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
      border: 1px solid rgba(0, 0, 0, 0.08);
      transition: box-shadow 0.15s, transform 0.15s;
      display: block;
    }
    .game-card:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
      transform: translateY(-2px);
    }
    .game-card-icon {
      font-size: 44px;
      margin-bottom: 14px;
      line-height: 1;
      position: relative;
      display: inline-block;
    }
    .icon-badge {
      position: absolute;
      font-size: 20px;
      bottom: -4px;
      right: -10px;
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.2));
    }
    .game-card-title {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 6px;
    }
    .game-card-desc {
      font-size: 14px;
      color: #6b6961;
      margin: 0;
      line-height: 1.5;
    }
    .game-card-meta {
      margin-top: 14px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .tag {
      font-size: 11px;
      font-weight: 600;
      background: #f5f1e8;
      color: #6b6961;
      border-radius: 20px;
      padding: 3px 10px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .about {
      background: #fff;
      border-radius: 12px;
      padding: 28px 28px 24px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      margin-bottom: 32px;
    }
    .about p {
      font-size: 15px;
      color: #4a4a48;
      line-height: 1.65;
      margin: 0;
    }
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
      margin: 20px 0 0;
    }
    .feature {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: #4a4a48;
    }
    .feature-icon {
      font-size: 20px;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .faq {
      margin-bottom: 0;
    }
    .faq details {
      background: #fff;
      border-radius: 10px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      margin-bottom: 10px;
      overflow: hidden;
    }
    .faq details summary {
      padding: 16px 20px;
      cursor: pointer;
      font-size: 15px;
      font-weight: 600;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      user-select: none;
    }
    .faq details summary::-webkit-details-marker { display: none; }
    .faq details summary::after {
      content: '+';
      font-size: 20px;
      font-weight: 300;
      color: #6b6961;
      transition: transform 0.2s;
      flex-shrink: 0;
    }
    .faq details[open] summary::after {
      transform: rotate(45deg);
    }
    .faq details p {
      padding: 0 20px 16px;
      font-size: 14px;
      color: #4a4a48;
      line-height: 1.6;
      margin: 0;
    }
    .section-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #4a9e6b;
      margin: 0 0 12px;
    }
    @media (max-width: 480px) {
      main { padding: 32px 16px 48px; }
      h1 { font-size: 26px; }
      .about { padding: 20px 18px; }
    }
  </style>
  <main>
    <p class="section-label">Free Online Games</p>
    <h1>Casual Games for Kids &amp; Adults</h1>
    <p class="subtitle">No download, no account. Pick a game and play.</p>

    <div class="games-grid">
      <a class="game-card" href="/sheep-gates/" aria-label="Play Sheep Gates">
        <div class="game-card-icon">🐑<span class="icon-badge">🐺</span></div>
        <div class="game-card-title">Sheep Gates</div>
        <p class="game-card-desc">Seven gates, one wolf. Pick the right one and keep going.</p>
        <div class="game-card-meta">
          <span class="tag">Casual</span>
          <span class="tag">Arcade</span>
          <span class="tag">Kids</span>
          <span class="tag">Free</span>
        </div>
      </a>
      <a class="game-card" href="/fat-sheep/" aria-label="Play Fat Grazing Sheep">
        <div class="game-card-icon">🐑<span class="icon-badge">🌿</span></div>
        <div class="game-card-title">Fat Grazing Sheep</div>
        <p class="game-card-desc">Guide your sheep, eat everything, grow enormous, and dodge the sheepdogs. How fat can you get?</p>
        <div class="game-card-meta">
          <span class="tag">Casual</span>
          <span class="tag">Movement</span>
          <span class="tag">Kids</span>
          <span class="tag">Free</span>
        </div>
      </a>
      <a class="game-card" href="/plop-drop/" aria-label="Play Plop Drop">
        <div class="game-card-icon">🐑<span class="icon-badge">🚽</span></div>
        <div class="game-card-title">Plop Drop</div>
        <p class="game-card-desc">Woolly drones zoom through the sky dropping plops! Move your toilet seat and catch them all before they hit the ground.</p>
        <div class="game-card-meta">
          <span class="tag">Casual</span>
          <span class="tag">Reflex</span>
          <span class="tag">Kids</span>
          <span class="tag">Free</span>
        </div>
      </a>
      <a class="game-card" href="/state-quest/" aria-label="Play Sheep State Quest">
        <div class="game-card-icon">🐑<span class="icon-badge">🗺️</span></div>
        <div class="game-card-title">Sheep State Quest</div>
        <p class="game-card-desc">Guide your sheep to the right US state on a blank map! Zoom in, pan around, and click before the timer runs out.</p>
        <div class="game-card-meta">
          <span class="tag">Geography</span>
          <span class="tag">Educational</span>
          <span class="tag">Kids</span>
          <span class="tag">Free</span>
        </div>
      </a>
    </div>

    <section class="about" aria-label="About Sheeps.online">
      <h2>Free browser games, no waiting</h2>
      <p>Sheeps.online is a handful of free browser games. No app, no account. Some take a few minutes, some longer. We keep adding more.</p>
      <div class="features">
        <div class="feature"><span class="feature-icon">🆓</span><span>100% free to play</span></div>
        <div class="feature"><span class="feature-icon">⚡</span><span>Instant, no install</span></div>
        <div class="feature"><span class="feature-icon">📱</span><span>Works on any device</span></div>
        <div class="feature"><span class="feature-icon">👨‍👩‍👧</span><span>Safe for kids</span></div>
        <div class="feature"><span class="feature-icon">🏆</span><span>Global leaderboards</span></div>
        <div class="feature"><span class="feature-icon">👥</span><span>Play with friends</span></div>
      </div>
    </section>

    <section class="faq" aria-label="Frequently asked questions">
      <p class="section-label" style="margin-top:32px">FAQ</p>
      <h2>Common Questions</h2>
      <details>
        <summary>Are the games free to play?</summary>
        <p>Yes, all free. No premium tier, no hidden anything.</p>
      </details>
      <details>
        <summary>Do I need to download or install anything?</summary>
        <p>Nothing to install. They run in your browser, on any device.</p>
      </details>
      <details>
        <summary>Are these games suitable for kids?</summary>
        <p>Yes. Nothing violent or creepy. Kids play them, and adults tend to get unreasonably competitive once they notice there's a leaderboard.</p>
      </details>
      <details>
        <summary>What devices are supported?</summary>
        <p>Any device with a browser works. Phone, tablet, laptop, that old desktop in the corner. Doesn't matter.</p>
      </details>
    </section>
  </main>
</BaseLayout>
