---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Games Portal">
  <Fragment slot="head">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>">
  </Fragment>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: #f5f1e8;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      color: #2c2c2a;
    }
    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 24px;
    }
    h1 {
      font-size: 32px;
      font-weight: 600;
      margin: 0 0 8px;
    }
    .subtitle {
      color: #6b6961;
      margin: 0 0 40px;
      font-size: 15px;
    }
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
    }
    .game-card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
      border: 1px solid rgba(0, 0, 0, 0.08);
      transition: box-shadow 0.15s, transform 0.15s;
      display: block;
    }
    .game-card:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
      transform: translateY(-2px);
    }
    .game-card-icon {
      font-size: 44px;
      margin-bottom: 14px;
      line-height: 1;
    }
    .game-card-title {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 6px;
    }
    .game-card-desc {
      font-size: 14px;
      color: #6b6961;
      margin: 0;
      line-height: 1.5;
    }
    @media (max-width: 480px) {
      main { padding: 32px 16px; }
      h1 { font-size: 26px; }
    }
  </style>
  <main>
    <h1>Games</h1>
    <p class="subtitle">Free games. Pick one and play.</p>
    <div class="games-grid">
      <a class="game-card" href="/sheep-gates/">
        <div class="game-card-icon">🐑</div>
        <div class="game-card-title">Sheep Gates</div>
        <p class="game-card-desc">Pick the open gate. Dodge the wolves. Survive as long as you can.</p>
      </a>
    </div>
  </main>
</BaseLayout>
